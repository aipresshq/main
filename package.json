{
  "name": "aisnap",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.mjs\" \"admin/**/*.mjs\" \"*.mjs\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"tests/**/*.{mjs,js}\" \"*.{mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"tests/**/*.{mjs,js}\" \"*.{mjs,json}\"",
    "preview": "astro preview",
    "test": "node tests/build-check.mjs",
    "test:admin": "node admin/frontmatter.test.mjs && node admin/authors-store.test.mjs && node admin/posts-store.test.mjs && node admin/validate-post.test.mjs && node admin/api-handlers.test.mjs && node admin/ui.test.mjs && node admin/integration.test.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "astro": "^7.1.6",
    "astro-pagefind": "^2.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "yaml": "^2.8.3"
  }
}
