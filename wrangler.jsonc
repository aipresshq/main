{
  "name": "main",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  // Cloudflare creates the DNS record and Advanced Certificate for this on deploy —
  // no manual dashboard step needed since the zone is already on Cloudflare nameservers.
  "routes": [
    { "pattern": "aipresshq.com", "custom_domain": true },
    { "pattern": "admin.aipresshq.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // `true`, not just the /admin paths, because src/worker.ts has to see every
    // request to noindex non-production hostnames — the static _headers file
    // cannot test the hostname, and a blanket noindex there would follow the
    // real domain into production forever. The tradeoff is that every request
    // now bills as a Worker invocation instead of being served by the asset
    // layer alone; at this site's traffic that is far inside the free tier.
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "aipresshq-images",
    },
  ],
  // Contact form submissions. See scripts/contact-schema.sql for the table
  // definition and admin/contact-store.mjs for the queries that read/write it.
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "aipresshq-contact",
      "database_id": "d5d668c0-f47b-42fd-ad73-7f35aebf2690",
    },
  ],
  // Brute-force protection for /admin/api/auth/login and spam protection for
  // the public contact form. Neither binding needs a provisioned resource —
  // the namespace_id just has to be unique and stable within the account,
  // since changing it resets every counter. Login: 8 attempts per minute per
  // client address (admin/worker-api.mjs, loginThrottled). Contact: 1
  // submission per minute per client address (src/worker.ts) — `period` only
  // accepts 10 or 60, so a longer cooldown isn't expressible here directly.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 },
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 1, "period": 60 },
    },
  ],
  // Server-side page-view counting. The site had no analytics of any kind, and
  // every request already passes through the Worker, so views are recorded here
  // rather than with a third-party beacon: no client script, no addition to the
  // CSP, no cookie, and no data leaving Cloudflare. See recordPageView in
  // src/worker.ts.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "aipresshq_pageviews" },
  ],
  // Without this, Worker logs are dropped and a production 500 leaves no trace.
  "observability": {
    "enabled": true,
  },
}
