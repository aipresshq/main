{
  "name": "main",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "aipresshq-images",
    },
  ],
}
