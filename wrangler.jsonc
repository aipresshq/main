{
  "name": "main",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // `true`, not just the /admin paths, because src/worker.ts has to see every
    // request to noindex non-production hostnames — the static _headers file
    // cannot test the hostname, and a blanket noindex there would follow the
    // real domain into production forever. The tradeoff is that every request
    // now bills as a Worker invocation instead of being served by the asset
    // layer alone; at this site's traffic that is far inside the free tier.
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "aipresshq-images",
    },
  ],
  // Brute-force protection for /admin/api/auth/login. This binding needs no
  // provisioned resource — the namespace_id just has to be unique and stable
  // within the account, since changing it resets every counter. 8 attempts per
  // minute per client address leaves room for a mistyped password and nothing
  // like room for guessing. Enforced in admin/worker-api.mjs (loginThrottled).
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 },
    },
  ],
  // Without this, Worker logs are dropped and a production 500 leaves no trace.
  "observability": {
    "enabled": true,
  },
}
