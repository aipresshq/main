---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import ArticleLatest from '../../components/ArticleLatest.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticleEndcap from '../../components/ArticleEndcap.astro';
import ContinuousReader from '../../components/ContinuousReader.astro';
import SuggestedReads from '../../components/SuggestedReads.astro';
import Subscribe from '../../components/Subscribe.astro';
import { formatEditionDate } from '../../lib/date';
import { getNextOlderPost, getPreviousNewerPost, sortPostsNewestFirst } from '../../lib/post-order';
import { getSuggestedPosts } from '../../lib/recommendations';
import { getAuthorId } from '../../lib/author-reference';
import { toSafeJsonLd } from '../../lib/json-ld';
import { getFormatDefinition } from '../../lib/formats';
import { getRuntimeContent } from '../../lib/content/runtime.mjs';

const repository = getRuntimeContent();
const [post, allPosts] = await Promise.all([
  repository.getPost(Astro.params.id ?? ''),
  repository.listPosts({ limit: 100 }),
]);
if (!post) return Astro.redirect('/404/', 302);
const authorId = getAuthorId(post.data.author);
const author = await getEntry('authors', authorId);
if (!author) {
  throw new Error(`Missing author profile for post: ${post.id} (author: ${authorId})`);
}

const { title, description, pubDate, updatedDate, cover, tags, format, postType } = post.data;

const suggested = getSuggestedPosts(post, allPosts, 4);
const nextPost = getNextOlderPost(post.id, allPosts);
const previousPost = getPreviousNewerPost(post.id, allPosts);

const latest = sortPostsNewestFirst(allPosts.filter((p) => p.id !== post.id)).slice(0, 5);

const site = Astro.site ?? 'https://aipresshq.com';
const formatDefinition = getFormatDefinition(format);
const postUrl = new URL(`/posts/${post.id}/`, site).href;

// postType already distinguishes short-lived news/leak coverage (digest) from
// lasting reference material (evergreen/tracker) — reusing it here instead of
// applying NewsArticle uniformly, since Google's structured-data guidance
// reserves NewsArticle for genuine news reporting.
const articleType = postType === 'digest' ? 'NewsArticle' : 'Article';

const schema = {
  '@context': 'https://schema.org',
  '@type': articleType,
  headline: title,
  description,
  image: [cover],
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: [
    {
      '@type': 'Person',
      name: author.data.name,
      url: new URL(`/authors/${author.id}/`, site).href,
    },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'aiPressHQ',
    url: site,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/brand/aipresshq-favicon-light.png', site).href,
      width: 512,
      height: 512,
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  articleSection: formatDefinition.label,
  keywords: tags,
  // Cheap properties that were simply absent. `url` saves consumers inferring
  // the canonical from @id, `inLanguage` matters for a publisher that could add
  // translations, and `isAccessibleForFree` states plainly that nothing here sits
  // behind a paywall — which is the kind of thing aggregators check for.
  url: postUrl,
  inLanguage: 'en',
  isAccessibleForFree: true,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'aiPressHQ', item: site },
    {
      '@type': 'ListItem',
      position: 2,
      name: formatDefinition.label,
      item: new URL(`/format/${format}/`, site).href,
    },
    { '@type': 'ListItem', position: 3, name: title, item: postUrl },
  ],
};
---

<BaseLayout
  title={`${title} | aiPressHQ`}
  description={description}
  editionDate={formatEditionDate(pubDate)}
  image={cover}
  type="article"
  publishedTime={pubDate}
  updatedTime={updatedDate}
>
  <script is:inline type="application/ld+json" set:html={toSafeJsonLd(schema)} />
  <script is:inline type="application/ld+json" set:html={toSafeJsonLd(breadcrumbSchema)} />

  <ContinuousReader currentPost={post} nextPost={nextPost}>
    <div class="article-layout">
      <ArticleToc currentPost={post} />
      <ArticleContent post={post} author={author} />
      <ArticleLatest posts={latest} currentPost={post} />
    </div>
  </ContinuousReader>

  <ArticleEndcap author={author} previousPost={previousPost} nextPost={nextPost} />
  <SuggestedReads posts={suggested} articleId={post.id} />
  <Subscribe />
</BaseLayout>
