---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import ArticleLatest from '../../components/ArticleLatest.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticleEndcap from '../../components/ArticleEndcap.astro';
import ContinuousReader from '../../components/ContinuousReader.astro';
import SuggestedReads from '../../components/SuggestedReads.astro';
import { formatEditionDate } from '../../lib/date';
import { getNextOlderPost, getPreviousNewerPost, sortPostsNewestFirst } from '../../lib/post-order';
import { getSuggestedPosts } from '../../lib/recommendations';
import { getAuthorId } from '../../lib/author-reference';
import { toSafeJsonLd } from '../../lib/json-ld';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props;
const authorId = getAuthorId(post.data.author);
const author = await getEntry('authors', authorId);
if (!author) {
  throw new Error(`Missing author profile for post: ${post.id} (author: ${authorId})`);
}

const { title, description, pubDate, updatedDate, cover } = post.data;

const suggested = getSuggestedPosts(post, allPosts, 4);
const nextPost = getNextOlderPost(post.id, allPosts);
const previousPost = getPreviousNewerPost(post.id, allPosts);

const latest = sortPostsNewestFirst(allPosts.filter((p) => p.id !== post.id)).slice(0, 5);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  image: [cover],
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: [
    {
      '@type': 'Person',
      name: author.data.name,
      url: new URL(`/authors/${author.id}/`, Astro.site ?? 'https://aipresshq.com').href,
    },
  ],
  publisher: { '@type': 'Organization', name: 'aiPressHQ' },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/posts/${post.id}/`, Astro.site ?? 'https://aipresshq.com').href,
  },
};
---

<BaseLayout
  title={`${title} | aiPressHQ`}
  description={description}
  editionDate={formatEditionDate(pubDate)}
>
  <script is:inline type="application/ld+json" set:html={toSafeJsonLd(schema)} />

  <ContinuousReader currentPost={post} nextPost={nextPost}>
    <div class="article-layout">
      <ArticleToc currentPost={post} />
      <ArticleContent post={post} author={author} />
      <ArticleLatest posts={latest} currentPost={post} />
    </div>
  </ContinuousReader>

  <ArticleEndcap author={author} previousPost={previousPost} nextPost={nextPost} />
  <SuggestedReads posts={suggested} articleId={post.id} />
</BaseLayout>
