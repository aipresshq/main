---
import { getCollection, getEntry } from 'astro:content';
import ArticleContent from '../../../components/ArticleContent.astro';
import ArticleLatest from '../../../components/ArticleLatest.astro';
import SuggestedReads from '../../../components/SuggestedReads.astro';
import { getNextOlderPost, sortPostsNewestFirst } from '../../../lib/post-order';
import { getSuggestedPosts } from '../../../lib/recommendations';
import { getAuthorId } from '../../../lib/author-reference';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props;
const authorId = getAuthorId(post.data.author);
const author = await getEntry('authors', authorId);
if (!author) {
  throw new Error(`Missing author profile for post: ${post.id} (author: ${authorId})`);
}

const suggested = getSuggestedPosts(post, allPosts, 4);
const nextPost = getNextOlderPost(post.id, allPosts);
const latest = sortPostsNewestFirst(allPosts.filter((entry) => entry.id !== post.id)).slice(0, 5);
const canonicalUrl = new URL(`/posts/${post.id}/`, Astro.site ?? 'https://aisnap.in').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body>
    <section
      class="continuous-article"
      data-continuous-article
      data-post-id={post.id}
      data-post-url={`/posts/${post.id}/`}
      data-document-title={`${post.data.title} | AI Snap`}
      data-next-fragment={nextPost ? `/posts/${nextPost.id}/fragment/` : undefined}
      data-next-url={nextPost ? `/posts/${nextPost.id}/` : undefined}
      data-next-title={nextPost?.data.title}
    >
      <div class="article-layout">
        <ArticleContent post={post} author={author} mode="stream" />
        <ArticleLatest posts={latest} currentPost={post} />
      </div>
      <SuggestedReads posts={suggested} variant="stream" articleId={post.id} />
    </section>
  </body>
</html>
