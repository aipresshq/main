---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFront from '../../components/CategoryFront.astro';
import { formatEditionDate } from '../../lib/date';
import { sortPostsNewestFirst } from '../../lib/post-order';
import { slugify } from '../../lib/slug';
import { knownTopics } from '../../lib/topics';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  // Union, not just post-derived tags: a canonical topic (like Tutorials)
  // gets a page even at zero posts, while an ad-hoc tag a post already uses
  // still gets one too, so nothing silently disappears before the taxonomy
  // catches up with content.
  const postTags = allPosts.flatMap((p) => p.data.tags);
  const allTags = [...new Set([...knownTopics, ...postTags])];
  return allTags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, allPosts },
  }));
}

const { tag, allPosts } = Astro.props;
const posts = sortPostsNewestFirst(allPosts.filter((p) => p.data.tags.includes(tag)));
---

<BaseLayout
  title={`${tag} | AI Snap`}
  description={`Latest AI Snap coverage tagged ${tag}.`}
  activeTag={tag}
  editionDate={posts[0] && formatEditionDate(posts[0].data.pubDate)}
>
  <CategoryFront
    title={tag}
    description={`Latest AI Snap coverage tagged ${tag}, with concise reporting, practical context, and the primary sources behind each story.`}
    posts={posts}
    emptyNote={`No stories tagged ${tag} yet.`}
  />
</BaseLayout>
