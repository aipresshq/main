---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stage from '../../components/Stage.astro';
import { formatEditionDate } from '../../lib/date';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];
  return allTags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, allPosts },
  }));
}

const { tag, allPosts } = Astro.props;
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
const posts = allPosts
  .filter((p) => p.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
	title={`${tag} — AI Snap`}
	description={`Latest AI Snap coverage tagged ${tag}.`}
	activeTag={tag}
	tags={allTags}
	editionDate={posts[0] && formatEditionDate(posts[0].data.pubDate)}
>
	<Stage posts={posts} emptyNote={`No stories tagged ${tag} yet.`} />
</BaseLayout>
