---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoryFront from '../../../components/CategoryFront.astro';
import Pagination from '../../../components/Pagination.astro';
import { formatEditionDate } from '../../../lib/date';
import { sortPostsNewestFirst } from '../../../lib/post-order';
import { slugify } from '../../../lib/slug';
import { getTopicDescription, knownTopics } from '../../../lib/topics';
import { buildCollectionPageSchema, toSafeJsonLd } from '../../../lib/json-ld';
import { ARCHIVE_PAGE_SIZE } from '../../../lib/pagination';
import { getRuntimeContent } from '../../../lib/content/runtime.mjs';
import { paginateEntries } from '../../../lib/content/pagination';

const repository = getRuntimeContent();
const storedTags = await repository.listTags();
const tag =
  knownTopics.find((entry) => slugify(entry) === Astro.params.tag) ??
  storedTags.find((entry) => entry.slug === Astro.params.tag)?.name;
if (!tag) return new Response('Not found.', { status: 404 });
const archivePosts = sortPostsNewestFirst(await repository.listPosts({ tag, limit: 100 }));
const page = paginateEntries(archivePosts, Astro.params.page, ARCHIVE_PAGE_SIZE);
if (!page) return new Response('Not found.', { status: 404 });
const basePath = `/tag/${Astro.params.tag}/`;
const site = Astro.site ?? 'https://aipresshq.com';
// Schema describes this page's own items, not the whole tag, so page two does
// not claim to list stories a reader cannot see on it.
const schemas =
  page.data.length > 0
    ? buildCollectionPageSchema({
        site,
        path: page.currentPage > 1 ? `${basePath}${page.currentPage}/` : basePath,
        name: tag,
        description: `Latest aiPressHQ coverage tagged ${tag}.`,
        postUrls: page.data.map((post) => new URL(`/posts/${post.id}/`, site).href),
      })
    : null;
const editionPost = page.data[0];
---

<BaseLayout
  title={page.currentPage > 1
    ? `${tag} — page ${page.currentPage} | aiPressHQ`
    : `${tag} | aiPressHQ`}
  description={`Latest aiPressHQ coverage tagged ${tag}.`}
  activeTag={tag}
  editionDate={editionPost && formatEditionDate(editionPost.data.pubDate)}
  noindex={page.data.length === 0}
  feed={{ href: `${basePath}rss.xml`, title: `aiPressHQ — ${tag}` }}
>
  {
    schemas && (
      <Fragment>
        <script
          is:inline
          type="application/ld+json"
          set:html={toSafeJsonLd(schemas.collectionPage)}
        />
        <script is:inline type="application/ld+json" set:html={toSafeJsonLd(schemas.breadcrumb)} />
      </Fragment>
    )
  }
  <CategoryFront
    title={tag}
    description={getTopicDescription(tag)}
    posts={page.data}
    archivePosts={archivePosts}
    showLead={page.currentPage === 1}
    emptyNote={`No stories tagged ${tag} yet.`}
  />
  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    basePath={basePath}
    label={`${tag} stories`}
  />
</BaseLayout>
