---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | AIPressHQ"
  description="The requested AIPressHQ page could not be found."
>
  <section class="not-found-page" aria-labelledby="not-found-title">
    <span class="label">404 / not in this edition</span>
    <h1 id="not-found-title">That page has moved on.</h1>
    <p>The address may be outdated, or the story may not have been published here.</p>
    <nav class="not-found-links" aria-label="Useful pages">
      <a href="/">Return to the front page <span aria-hidden="true">-&gt;</span></a>
      <a href="/latest/">Read the latest stories <span aria-hidden="true">-&gt;</span></a>
      <a href="/search/">Search the edition <span aria-hidden="true">-&gt;</span></a>
    </nav>
  </section>
</BaseLayout>
