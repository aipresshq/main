---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Stage from '../components/Stage.astro';
import FeatureBand from '../components/FeatureBand.astro';
import SplitFeature from '../components/SplitFeature.astro';
import HeadlineGrid from '../components/HeadlineGrid.astro';
import { formatEditionDate } from '../lib/date';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

// The stage takes the top five: lead, "next" teaser, and three rail stories.
const stagePosts = posts.slice(0, 5);
const inStage = new Set(stagePosts.map((p) => p.id));

// Trackers and Explainers are section fronts — complete listings by type, so a
// story showing in both the hero and its own section is expected, as in print.
const trackers = posts.filter((p) => p.data.postType === 'tracker').slice(0, 5);
const evergreen = posts.filter((p) => p.data.postType === 'evergreen').slice(0, 5);

// The digest is what the front hasn't already shown.
const digest = posts.filter((p) => !inStage.has(p.id)).slice(0, 8);
---

<BaseLayout
	title="AI Snap — Daily AI News"
	description="Daily AI news, evergreen comparisons, and usage-limit trackers across every major AI lab."
	activeTab="latest"
	tags={allTags}
	editionDate={posts[0] && formatEditionDate(posts[0].data.pubDate)}
>
	<Stage posts={stagePosts} emptyNote="No stories published yet." />

	{trackers.length > 0 && <FeatureBand title="Trackers" href="/trackers/" posts={trackers} />}

	{evergreen.length > 0 && <SplitFeature title="Explainers & comparisons" posts={evergreen} />}

	{digest.length > 0 && <HeadlineGrid title="More from today" posts={digest} />}
</BaseLayout>
