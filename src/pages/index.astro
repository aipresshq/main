---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Stage from '../components/Stage.astro';
import LatestSection from '../components/LatestSection.astro';
import FeatureBand from '../components/FeatureBand.astro';
import HeadlineGrid from '../components/HeadlineGrid.astro';
import NewsroomGrid from '../components/NewsroomGrid.astro';
import DeskIndex from '../components/DeskIndex.astro';
import RelatedNews from '../components/RelatedNews.astro';
import DeskShowcase from '../components/DeskShowcase.astro';
import BriefingBoard from '../components/BriefingBoard.astro';
import StoryTimeline from '../components/StoryTimeline.astro';
import TopicDirectory from '../components/TopicDirectory.astro';
import { formatEditionDate } from '../lib/date';
import { sortPostsNewestFirst } from '../lib/post-order';
import { slugify } from '../lib/slug';
import { topicGroups } from '../lib/topics';

const posts = sortPostsNewestFirst(await getCollection('posts'));

const storyCount = posts.length;

// A small catalog can't spare five posts for the hero alone: every post held
// back here is one fewer available to every section below it. Three still
// covers a lead plus two picks; a bigger edition can afford the full five.
const stagePosts = posts.slice(0, Math.min(storyCount, storyCount >= 24 ? 5 : 3));
const inStage = new Set(stagePosts.map((p) => p.id));
const remainingPosts = posts.filter((p) => !inStage.has(p.id));
const latestLimit = storyCount >= 18 ? 6 : storyCount >= 10 ? 2 : storyCount >= 6 ? 2 : 0;
const latestPosts = remainingPosts.slice(0, latestLimit);
const allocatedIds = new Set([...inStage, ...latestPosts.map((p) => p.id)]);

const picks = posts.filter((p) => p.data.featured);
const stagePicks = picks.filter((p) => inStage.has(p.id));

const companyTags = new Set([
  'OpenAI',
  'Anthropic',
  'Google DeepMind',
  'Meta',
  'Microsoft',
  'Mistral',
]);
const deskCandidateIds = new Set<string>();

// One per column, not three: a small catalog spends its whole remaining pool
// on one greedy column otherwise, leaving the other two — and every section
// below this one — empty regardless of what they're flagged with.
function collectDeskStories(predicate: (post: (typeof posts)[number]) => boolean) {
  const selected = remainingPosts
    .filter(
      (post) => !allocatedIds.has(post.id) && !deskCandidateIds.has(post.id) && predicate(post),
    )
    .slice(0, 1);

  selected.forEach((post) => {
    deskCandidateIds.add(post.id);
  });
  return selected;
}

const applicationCandidates = collectDeskStories(
  (post) => post.data.tags.includes('Product Launch') || post.data.tags.includes('AI'),
);
const usageCandidates = collectDeskStories((post) => post.data.postType === 'tracker');
const companyCandidates = collectDeskStories(
  (post) => post.data.postType !== 'tracker' && post.data.tags.some((tag) => companyTags.has(tag)),
);
const deskCandidateCount = deskCandidateIds.size;
const showDeskIndex = deskCandidateCount >= 2;
if (showDeskIndex) {
  deskCandidateIds.forEach((id) => allocatedIds.add(id));
}
const applicationsPosts = showDeskIndex ? applicationCandidates : [];
const usagePosts = showDeskIndex ? usageCandidates : [];
const companyPosts = showDeskIndex ? companyCandidates : [];

const deskColumns = [
  { title: 'Applications', href: '/tag/product-launch/', posts: applicationsPosts },
  { title: 'Companies & labs', href: '/latest/', posts: companyPosts },
  { title: 'Usage & access', href: '/trackers/', posts: usagePosts },
];

const relatedNews = remainingPosts
  .filter((post) => !allocatedIds.has(post.id) && post.data.featured)
  .slice(0, 6);
relatedNews.forEach((post) => allocatedIds.add(post.id));

// Every threshold below this line requires only enough posts for the
// component to render without empty grid cells (verified against each
// component's markup), not the deeper pool the modules were designed
// around — an edition with a dozen posts still fills most sections at one
// or two stories each, rather than staying hidden until the catalog is ten
// times bigger.
const availableAfterRelated = remainingPosts.filter((post) => !allocatedIds.has(post.id));
const deskShowcasePosts =
  availableAfterRelated.length >= 1 ? availableAfterRelated.slice(0, 3) : [];
deskShowcasePosts.forEach((post) => allocatedIds.add(post.id));
const [deskLead, ...deskRemainder] = deskShowcasePosts;
const deskHeadlines = deskRemainder.slice(0, 3);
const deskSidePosts = deskRemainder.slice(3, 6);
const deskLowerPosts = deskRemainder.slice(6, 10);
const showcaseTopics = ['OpenAI', 'Comparisons', 'Research', 'Product Launch', 'Funding'].map(
  (topic) => ({
    label: topic,
    href: `/tag/${slugify(topic)}/`,
  }),
);

const availableAfterShowcase = remainingPosts.filter((post) => !allocatedIds.has(post.id));
const trackers = availableAfterShowcase
  .filter((post) => post.data.postType === 'tracker')
  .slice(0, 5);
trackers.forEach((post) => allocatedIds.add(post.id));

// Briefing's list, the timeline, and "more from today" are all recap formats
// with no unique visual hook of their own (no cover photo, no featured flag)
// — at low volume they share this last pool rather than exhausting it from
// each other, the same way deskLead above is already shared between
// DeskShowcase and BriefingBoard. A dozen posts cannot give every recap
// format its own exclusive tail; showing the same handful of leftovers a
// couple of ways reads as "today's rundown," not as a bug.
const fillerPool = remainingPosts.filter((post) => !allocatedIds.has(post.id));
const briefingPosts = deskLead ? fillerPool.slice(0, 5) : [];
const timelinePosts = fillerPool.slice(0, 6);
const digest = fillerPool.slice(0, 8);

const newsroomPosts = picks.filter((post) => !allocatedIds.has(post.id)).slice(0, 6);
newsroomPosts.forEach((post) => allocatedIds.add(post.id));

const directoryGroups = topicGroups
  .map((group) => ({
    label: group.label,
    topics: group.topics
      .map((topic) => ({
        label: topic,
        href: `/tag/${slugify(topic)}/`,
        count: posts.filter((post) => post.data.tags.includes(topic)).length,
      }))
      .filter((topic) => topic.count > 0),
  }))
  .filter((group) => group.topics.length > 0);
---

<BaseLayout
  title="aiPressHQ | Daily AI News"
  description="Daily AI news, evergreen comparisons, and usage-limit trackers across every major AI lab."
  editionDate={posts[0] && formatEditionDate(posts[0].data.pubDate)}
>
  <Stage posts={stagePosts} picks={stagePicks} emptyNote="No stories published yet." />

  {latestPosts.length > 0 && <LatestSection posts={latestPosts} />}

  {showDeskIndex && <DeskIndex columns={deskColumns} />}

  {relatedNews.length > 0 && <RelatedNews posts={relatedNews} />}

  {
    deskLead && (
      <DeskShowcase
        title="Across AI"
        href="/tag/ai/"
        lead={deskLead}
        headlines={deskHeadlines}
        sidePosts={deskSidePosts}
        lowerPosts={deskLowerPosts}
        topics={showcaseTopics}
      />
    )
  }

  {
    briefingPosts.length > 0 && deskLead && (
      <BriefingBoard posts={briefingPosts} feature={deskLead} />
    )
  }

  {timelinePosts.length > 0 && <StoryTimeline posts={timelinePosts} />}

  {directoryGroups.length > 0 && <TopicDirectory groups={directoryGroups} />}

  {trackers.length > 0 && <FeatureBand title="Trackers" href="/trackers/" posts={trackers} />}

  {digest.length > 0 && <HeadlineGrid title="More from today" posts={digest} />}

  {
    newsroomPosts.length > 0 && (
      <NewsroomGrid title="Editor's Picks" href="/trending/" posts={newsroomPosts} />
    )
  }
</BaseLayout>
