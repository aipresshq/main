---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFront from '../../components/CategoryFront.astro';
import Pagination from '../../components/Pagination.astro';
import { formatEditionDate } from '../../lib/date';
import { sortPostsNewestFirst } from '../../lib/post-order';
import { ARCHIVE_PAGE_SIZE } from '../../lib/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('posts');
  const posts = sortPostsNewestFirst(allPosts.filter((post) => post.data.postType === 'tracker'));
  return paginate(posts, { pageSize: ARCHIVE_PAGE_SIZE, props: { archivePosts: posts } });
}) satisfies GetStaticPaths;

const { page, archivePosts } = Astro.props;
const editionPost = page.data[0];
---

<BaseLayout
  title={page.currentPage > 1
    ? `Trackers — page ${page.currentPage} | aiPressHQ`
    : 'Trackers | aiPressHQ'}
  description="Live usage-limit and pricing trackers for major AI tools, updated regularly."
  activeTab="trackers"
  editionDate={editionPost && formatEditionDate(editionPost.data.pubDate)}
  noindex={page.data.length === 0}
>
  <CategoryFront
    title="Trackers"
    description="Live usage-limit, pricing, and access guides for major AI tools, kept current as plans and product details change."
    posts={page.data}
    archivePosts={archivePosts}
    showLead={page.currentPage === 1}
    emptyNote="No trackers published yet."
  />
  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    basePath="/trackers/"
    label="Trackers"
  />
</BaseLayout>
