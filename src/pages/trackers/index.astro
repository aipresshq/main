---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFront from '../../components/CategoryFront.astro';
import { formatEditionDate } from '../../lib/date';

const allPosts = await getCollection('posts');
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
const posts = allPosts
  .filter((p) => p.data.postType === 'tracker')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
	title="Trackers — AI Snap"
	description="Live usage-limit and pricing trackers for major AI tools, updated regularly."
	activeTab="trackers"
	tags={allTags}
	editionDate={posts[0] && formatEditionDate(posts[0].data.pubDate)}
>
	<CategoryFront
		title="Trackers"
		description="Live usage-limit, pricing, and access guides for major AI tools, kept current as plans and product details change."
		posts={posts}
		emptyNote="No trackers published yet."
	/>
</BaseLayout>
