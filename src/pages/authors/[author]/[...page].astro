---
import { getEntry } from 'astro:content';
import AuthorStoryCard from '../../../components/AuthorStoryCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import { formatEditionDate } from '../../../lib/date';
import { toSafeJsonLd } from '../../../lib/json-ld';
import { ARCHIVE_PAGE_SIZE } from '../../../lib/pagination';
import { getRuntimeContent } from '../../../lib/content/runtime.mjs';
import { paginateRepository } from '../../../lib/content/pagination';

const author = await getEntry('authors', Astro.params.author ?? '');
if (!author) return new Response('Not found.', { status: 404 });
const page = await paginateRepository(
  getRuntimeContent(),
  { authorId: author.id },
  Astro.params.page,
  ARCHIVE_PAGE_SIZE,
);
if (!page) return new Response('Not found.', { status: 404 });
const totalStories = page.total;
const site = Astro.site ?? 'https://aipresshq.com';
const authorUrl = new URL(`/authors/${author.id}/`, site).href;
const socialLinks = [author.data.website, author.data.x, author.data.linkedin].filter(
  (url): url is string => Boolean(url),
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.data.name,
  description: author.data.bio,
  image: new URL(author.data.avatar, site).href,
  // Always the unpaginated profile: the Person is not per-page, so page two
  // must not mint a second identity for the same byline.
  url: authorUrl,
  sameAs: socialLinks,
};
const editionPost = page.data[0];
---

<BaseLayout
  title={page.currentPage > 1
    ? `${author.data.name} — page ${page.currentPage} | aiPressHQ`
    : `${author.data.name} | aiPressHQ`}
  description={author.data.bio}
  editionDate={editionPost && formatEditionDate(editionPost.data.pubDate)}
  image={author.data.avatar}
>
  {
    page.currentPage === 1 && (
      <script is:inline type="application/ld+json" set:html={toSafeJsonLd(schema)} />
    )
  }

  <div class="author-page">
    <header class="author-profile">
      <div class="author-profile-portrait">
        <img
          class="author-profile-avatar"
          src={author.data.avatar}
          alt=""
          width="220"
          height="220"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="author-profile-copy">
        <span class="label author-profile-kicker">Author / editorial desk</span>
        <h1>{author.data.name}</h1>
        <p class="author-profile-role">{author.data.role}</p>
        <p class="author-profile-bio">{author.data.bio}</p>
      </div>
      <div class="author-profile-aside">
        <span class="label author-profile-count-label">Archive</span>
        <p class="author-story-count">
          <strong>{totalStories}</strong>
          <span>published {totalStories === 1 ? 'story' : 'stories'}</span>
        </p>
        {
          socialLinks.length > 0 && (
            <nav class="author-socials" aria-label={`${author.data.name} links`}>
              {author.data.website && <a href={author.data.website}>Website</a>}
              {author.data.x && <a href={author.data.x}>X</a>}
              {author.data.linkedin && <a href={author.data.linkedin}>LinkedIn</a>}
            </nav>
          )
        }
      </div>
    </header>

    <section class="author-archive" aria-labelledby="author-stories-heading">
      <div class="author-archive-heading">
        <div>
          <span class="label">Archive / newest first</span>
          <h2 id="author-stories-heading">Published stories</h2>
        </div>
        <span class="author-archive-total"
          >{totalStories} {totalStories === 1 ? 'story' : 'stories'}</span
        >
      </div>
      {
        page.data.length === 0 ? (
          <p class="author-empty">No published stories yet.</p>
        ) : (
          <div class="author-story-grid">
            {page.data.map((post) => (
              <AuthorStoryCard post={post} />
            ))}
          </div>
        )
      }
      <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        basePath={`/authors/${author.id}/`}
        label={`${author.data.name} stories`}
      />
    </section>
  </div>
</BaseLayout>
