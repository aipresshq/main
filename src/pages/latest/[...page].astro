---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFront from '../../components/CategoryFront.astro';
import Pagination from '../../components/Pagination.astro';
import { formatEditionDate } from '../../lib/date';
import { sortPostsNewestFirst } from '../../lib/post-order';
import { ARCHIVE_PAGE_SIZE } from '../../lib/pagination';

// `[...page]` keeps page one at /latest/ — the URL it has always had — and puts
// the rest at /latest/2/, so paginating this archive breaks no existing link.
export const getStaticPaths = (async ({ paginate }) => {
  const posts = sortPostsNewestFirst(await getCollection('posts'));
  return paginate(posts, { pageSize: ARCHIVE_PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const editionPost = page.data[0];
---

<BaseLayout
  title={page.currentPage > 1
    ? `Latest — page ${page.currentPage} | aiPressHQ`
    : 'Latest | aiPressHQ'}
  description="Every aiPressHQ story, newest first: launches, trackers, comparisons, and the daily digest."
  activeTab="latest"
  editionDate={editionPost && formatEditionDate(editionPost.data.pubDate)}
>
  <CategoryFront
    title="Latest"
    description="Every story, newest first: the daily digest alongside trackers, comparisons, and explainers."
    posts={page.data}
    emptyNote="No stories published yet."
  />
  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    basePath="/latest/"
    label="Latest stories"
  />
</BaseLayout>
