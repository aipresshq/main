---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFront from '../../components/CategoryFront.astro';
import Pagination from '../../components/Pagination.astro';
import { formatEditionDate } from '../../lib/date';
import { sortPostsNewestFirst } from '../../lib/post-order';
import { ARCHIVE_PAGE_SIZE } from '../../lib/pagination';
import { buildCollectionPageSchema, toSafeJsonLd } from '../../lib/json-ld';
import { monthLabel } from '../../lib/month-archive';
import { getRuntimeContent } from '../../lib/content/runtime.mjs';
import { paginateEntries } from '../../lib/content/pagination';

/**
 * Month archives at /archive/YYYY/MM/.
 *
 * A dated timeline is the one way into a news site that does not depend on the
 * tag taxonomy being right, and it is what readers reach for when they remember
 * roughly when something happened rather than what it was called. Months, not
 * days: a day archive on a site publishing a story or two a day is mostly empty
 * pages.
 *
 * The helpers live in src/lib/month-archive.ts because Astro extracts
 * getStaticPaths into its own module chunk, where frontmatter consts are not in
 * scope.
 */
const parts = (Astro.params.page ?? '').split('/').filter(Boolean);
const [year, month, pagePart] = parts;
if (!/^\d{4}$/.test(year ?? '') || !/^(0[1-9]|1[0-2])$/.test(month ?? '') || parts.length > 3) {
  return new Response('Not found.', { status: 404 });
}
const monthKeyValue = `${year}-${month}`;
const start = `${monthKeyValue}-01`;
const nextMonth = new Date(Date.UTC(Number(year), Number(month), 1)).toISOString().slice(0, 10);
const archivePosts = sortPostsNewestFirst(
  await getRuntimeContent().listPosts({ pubDateFrom: start, pubDateBefore: nextMonth, limit: 100 }),
);
const page = paginateEntries(archivePosts, pagePart, ARCHIVE_PAGE_SIZE);
if (!page) return new Response('Not found.', { status: 404 });
const label = monthLabel(monthKeyValue);
const basePath = `/archive/${year}/${month}/`;
const site = Astro.site ?? 'https://aipresshq.com';
const schemas =
  page.data.length > 0
    ? buildCollectionPageSchema({
        site,
        path: page.currentPage > 1 ? `${basePath}${page.currentPage}/` : basePath,
        name: `${label} archive`,
        description: `Every aiPressHQ story published in ${label}.`,
        postUrls: page.data.map((post) => new URL(`/posts/${post.id}/`, site).href),
      })
    : null;
const editionPost = page.data[0];
---

<BaseLayout
  title={page.currentPage > 1
    ? `${label} — page ${page.currentPage} | aiPressHQ`
    : `${label} | aiPressHQ`}
  description={`Every aiPressHQ story published in ${label}.`}
  editionDate={editionPost && formatEditionDate(editionPost.data.pubDate)}
  noindex={page.data.length === 0}
>
  {
    schemas && (
      <Fragment>
        <script
          is:inline
          type="application/ld+json"
          set:html={toSafeJsonLd(schemas.collectionPage)}
        />
        <script is:inline type="application/ld+json" set:html={toSafeJsonLd(schemas.breadcrumb)} />
      </Fragment>
    )
  }
  <CategoryFront
    title={label}
    description={`Everything published in ${label}, newest first.`}
    posts={page.data}
    archivePosts={archivePosts}
    showLead={page.currentPage === 1}
    emptyNote={`Nothing was published in ${label}.`}
  />
  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    basePath={basePath}
    label={`${label} archive`}
  />
</BaseLayout>
