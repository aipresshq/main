---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFront from '../../components/CategoryFront.astro';
import { formatEditionDate } from '../../lib/date';
import { getFormatDefinition, storyFormats, type StoryFormat } from '../../lib/formats';
import { sortPostsNewestFirst } from '../../lib/post-order';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');

  return storyFormats.map((definition) => ({
    params: { format: definition.key },
    props: { format: definition.key, allPosts },
  }));
}

interface Props {
  format: StoryFormat;
  allPosts: CollectionEntry<'posts'>[];
}

const { format, allPosts } = Astro.props as Props;
const definition = getFormatDefinition(format);
const posts = sortPostsNewestFirst(allPosts.filter((post) => post.data.format === format));
---

<BaseLayout
  title={`${definition.label} | AIPressHQ`}
  description={definition.description}
  activeFormat={format}
  editionDate={posts[0] && formatEditionDate(posts[0].data.pubDate)}
>
  <CategoryFront
    title={definition.label}
    description={definition.description}
    posts={posts}
    emptyNote={`No ${definition.label.toLowerCase()} published yet.`}
  />
</BaseLayout>
