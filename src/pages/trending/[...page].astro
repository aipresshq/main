---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFront from '../../components/CategoryFront.astro';
import Pagination from '../../components/Pagination.astro';
import { formatEditionDate } from '../../lib/date';
import { sortPostsNewestFirst } from '../../lib/post-order';
import { ARCHIVE_PAGE_SIZE } from '../../lib/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('posts');
  const posts = sortPostsNewestFirst(allPosts.filter((post) => post.data.featured));
  return paginate(posts, { pageSize: ARCHIVE_PAGE_SIZE, props: { archivePosts: posts } });
}) satisfies GetStaticPaths;

const { page, archivePosts } = Astro.props;
const editionPost = page.data[0];
---

<BaseLayout
  title={page.currentPage > 1
    ? `Trending — page ${page.currentPage} | aiPressHQ`
    : 'Trending | aiPressHQ'}
  description="Hand-picked trending AI news and analysis from aiPressHQ."
  activeTab="trending"
  editionDate={editionPost && formatEditionDate(editionPost.data.pubDate)}
  noindex={page.data.length === 0}
>
  <CategoryFront
    title="Trending"
    description="The stories our editors are watching most closely: launches, research, funding, and the claims worth checking next."
    posts={page.data}
    archivePosts={archivePosts}
    showLead={page.currentPage === 1}
    emptyNote="No trending stories right now."
  />
  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    basePath="/trending/"
    label="Trending stories"
  />
</BaseLayout>
