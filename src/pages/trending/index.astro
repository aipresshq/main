---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stage from '../../components/Stage.astro';
import { formatEditionDate } from '../../lib/date';

const allPosts = await getCollection('posts');
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
const posts = allPosts
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
	title="Trending — AI Snap"
	description="Hand-picked trending AI news and analysis from AI Snap."
	activeTab="trending"
	tags={allTags}
	editionDate={posts[0] && formatEditionDate(posts[0].data.pubDate)}
>
	<Stage posts={posts} emptyNote="No trending stories right now." />
</BaseLayout>
