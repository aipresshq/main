---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';
import CoverImage from './CoverImage.astro';

export interface Props {
  title: string;
  href?: string;
  posts: CollectionEntry<'posts'>[];
}

const { title, href, posts } = Astro.props;
const [lead, ...rest] = posts;
const cards = rest.slice(0, 4);
const signal = rest.slice(0, 5);
---

{
  lead && (
    <section class="newsroom-section" aria-labelledby="newsroom-heading">
      <div class="newsroom-section-head home-section-heading">
        <div>
          <span class="label">The daily desk</span>
          <h2 class="home-section-heading-title" id="newsroom-heading">
            {title}
          </h2>
        </div>
        {href && (
          <a class="newsroom-section-link home-section-heading-link" href={href}>
            See all <span aria-hidden="true">→</span>
          </a>
        )}
      </div>

      <div class="newsroom-grid">
        <a class="newsroom-lead" href={`/posts/${lead.id}/`}>
          <CoverImage
            src={lead.data.cover}
            alt={lead.data.coverAlt}
            sizes="(max-width: 900px) 100vw, 50vw"
          />
          <span class="label">{lead.data.tags[0]}</span>
          <h3>{lead.data.title}</h3>
          <time datetime={lead.data.pubDate.toISOString()}>
            {formatPostDate(lead.data.pubDate)}
          </time>
        </a>

        <div class="newsroom-cards">
          {cards.map((post) => (
            <a class="newsroom-card" href={`/posts/${post.id}/`}>
              <CoverImage
                src={post.data.cover}
                alt={post.data.coverAlt}
                sizes="(max-width: 900px) 50vw, 25vw"
              />
              <span class="label">{post.data.tags[0]}</span>
              <h3>{post.data.title}</h3>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatPostDate(post.data.pubDate)}
              </time>
            </a>
          ))}
        </div>

        <aside class="newsroom-signal" aria-labelledby="newsroom-signal-heading">
          <div class="newsroom-signal-head">
            <span class="label">Editorial signal</span>
            <h2 id="newsroom-signal-heading">Worth your time</h2>
          </div>
          <ol>
            {signal.map((post) => (
              <li>
                <a href={`/posts/${post.id}/`}>
                  <span class="label">{post.data.tags[0]}</span>
                  <h3>{post.data.title}</h3>
                </a>
              </li>
            ))}
          </ol>
          {href && (
            <a class="newsroom-signal-link" href={href}>
              Browse the desk <span aria-hidden="true">→</span>
            </a>
          )}
        </aside>
      </div>
    </section>
  )
}
