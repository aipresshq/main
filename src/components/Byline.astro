---
// Author + category byline used on hero cards, feed cards, and the right rail.
// `onDark` switches it to the white treatment used over card imagery.
export interface Props {
  author: string;
  category: string;
  onDark?: boolean;
}

const { author, category, onDark = false } = Astro.props;
---

<span class:list={['byline', { 'byline-on-dark': onDark }]}>
	<span class="byline-avatar" aria-hidden="true">{author.charAt(0)}</span>
	<span class="byline-text">
		<span class="byline-name">{author}</span>
		<span class="byline-dot">•</span>
		<span class="byline-category">{category}</span>
	</span>
</span>
