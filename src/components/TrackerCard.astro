---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<a class="tracker-card" href={`/posts/${post.id}/`}>
	<span class="tracker-badge">
		<span class="tracker-dot" aria-hidden="true"></span>
		Live
	</span>
	<h3 class="tracker-title">{post.data.title}</h3>
	<p class="tracker-desc">{post.data.description}</p>
	<span class="label tracker-updated">Updated {formatPostDate(post.data.pubDate)}</span>
</a>
