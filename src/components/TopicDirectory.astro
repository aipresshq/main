---
export interface TopicLink {
  label: string;
  href: string;
  count: number;
}

export interface TopicGroup {
  label: string;
  topics: TopicLink[];
}

export interface Props {
  groups: TopicGroup[];
}

const { groups } = Astro.props;
---

<section class="topic-directory" aria-labelledby="topic-directory-heading">
  <div class="topic-directory-intro">
    <span class="label">Browse the taxonomy</span>
    <h2 class="home-section-heading-title" id="topic-directory-heading">Follow an idea.</h2>
    <p>Move from a headline to the companies, themes, and working questions behind it.</p>
    <a class="topic-directory-link" href="/tag/ai/"
      >Browse all AI coverage <span aria-hidden="true">-&gt;</span></a
    >
  </div>

  <div class="topic-directory-groups">
    {
      groups.map((group) => (
        <section
          class="topic-directory-group"
          aria-labelledby={`topic-group-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
        >
          <h3 id={`topic-group-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
            {group.label}
          </h3>
          <div class="topic-directory-links">
            {group.topics.map((topic) => (
              <a href={topic.href}>
                <span>{topic.label}</span>
                <small>{topic.count}</small>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>
