---
// Inline SVG icons used across cards and the right rail. Kept in one place so
// the same glyph can't drift between the feed and the sidebar.
export interface Props {
  name: 'calendar' | 'eye' | 'bookmark' | 'bolt';
  size?: number;
}

const { name, size = 14 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'calendar' && (
			<Fragment>
				<rect x="3" y="4" width="18" height="18" rx="2" />
				<line x1="16" y1="2" x2="16" y2="6" />
				<line x1="8" y1="2" x2="8" y2="6" />
				<line x1="3" y1="10" x2="21" y2="10" />
			</Fragment>
		)
	}
	{
		name === 'eye' && (
			<Fragment>
				<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
				<circle cx="12" cy="12" r="3" />
			</Fragment>
		)
	}
	{name === 'bookmark' && <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />}
	{name === 'bolt' && <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" fill="currentColor" stroke="none" />}
</svg>
