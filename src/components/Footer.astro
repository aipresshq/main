---
import { slugify } from '../lib/slug';
import { topicGroups } from '../lib/topics';
import BrandMark from './BrandMark.astro';

export interface Props {}

const sections = [
  { label: 'Latest', href: '/latest/' },
  { label: 'Trending', href: '/trending/' },
  { label: 'Trackers', href: '/trackers/' },
  { label: 'Tutorials', href: '/tag/tutorials/' },
];

// Keep the footer useful without turning it into a second full categories page.
const footerTopics = topicGroups.flatMap((group) => group.topics.slice(0, 2)).slice(0, 8);

// The dateline elsewhere comes from content; the copyright year is about the
// site itself, so it's stamped at build time.
const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="footer-topline">
    <span class="label">aiPressHQ / Daily AI News</span>
    <span class="footer-topline-note">Source-linked reporting / Human-reviewed publishing</span>
  </div>

  <div class="footer-intro">
    <div class="footer-intro-copy">
      <a href="/" class="footer-wordmark" aria-label="aiPressHQ home">
        <BrandMark />
      </a>
      <h2 class="footer-headline">Context for the fast-moving AI desk.</h2>
      <p>
        Clear reporting, practical explainers, and trackers for the products and companies shaping
        artificial intelligence.
      </p>
    </div>

    <nav class="footer-cta-links" aria-label="Footer editorial sections">
      <a href="/latest/">Latest updates <span aria-hidden="true">-&gt;</span></a>
      <a href="/trending/">Editor's picks <span aria-hidden="true">-&gt;</span></a>
      <a href="/trackers/">Usage trackers <span aria-hidden="true">-&gt;</span></a>
      <a href="/tag/tutorials/">Tutorials <span aria-hidden="true">-&gt;</span></a>
    </nav>
  </div>

  <div class="footer-rule" aria-hidden="true"></div>

  <div class="footer-columns">
    <section class="footer-column">
      <h3>Read</h3>
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={s.href}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="footer-column">
      <h3>Topics</h3>
      <ul>
        {
          footerTopics.map((tag) => (
            <li>
              <a href={`/tag/${slugify(tag)}/`}>{tag}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="footer-column">
      <h3>Explore</h3>
      <ul>
        <li><a href="/authors/tejas-telkar/">Tejas Telkar</a></li>
        <li><a href="/about/">Our method</a></li>
        <li><a href="/saved/">Saved stories</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </section>

    <section class="footer-column">
      <h3>Legal</h3>
      <ul>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Service</a></li>
        <li><a href="/cookies/">Cookie Policy</a></li>
      </ul>
    </section>
  </div>

  <div class="footer-base">
    <span>© {year} aiPressHQ. All rights reserved.</span>
    <span>Built for reading, not noise.</span>
  </div>
</footer>
