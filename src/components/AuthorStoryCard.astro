---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';
import { formatLabel } from '../lib/formats';
import { readMinutes } from '../lib/read-time';
import CoverImage from './CoverImage.astro';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<a class="author-story" href={`/posts/${post.id}/`}>
  <CoverImage
    src={post.data.cover}
    alt={post.data.coverAlt}
    sizes="(max-width: 780px) 100vw, 33vw"
  />
  <span class="label author-story-tag">{formatLabel(post.data.format)}</span>
  <h2 class="author-story-title">{post.data.title}</h2>
  <p class="author-story-description">{post.data.description}</p>
  <span class="author-story-meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{readMinutes(post)} min read</span>
  </span>
</a>
