---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';
import { getAuthorId } from '../lib/author-reference';
import { slugify } from '../lib/slug';

export interface Props {
  posts: CollectionEntry<'posts'>[];
  currentPost: CollectionEntry<'posts'>;
}

const { posts, currentPost } = Astro.props;
const { headings } = await render(currentPost);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const authorId = getAuthorId(currentPost.data.author);
const currentAuthor = await getEntry('authors', authorId);
if (!currentAuthor) {
  throw new Error(`Missing author profile for post: ${currentPost.id} (author: ${authorId})`);
}

const tocId = `article-toc-${currentPost.id}`;
const topicId = `article-topics-${currentPost.id}`;
const latestId = `article-latest-${currentPost.id}`;
---

<aside class="article-sidebar" aria-label="Article sidebar" data-pagefind-ignore>
  <details
    class="article-toc article-sidebar-module"
    data-mobile-sidebar
    open
    aria-labelledby={tocId}
  >
    <summary class="article-rail-heading">
      <span class="label article-rail-eyebrow">Read the story</span>
      <h2 id={tocId}>In this story</h2>
    </summary>
    <ol>
      {
        tocHeadings.map((heading) => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))
      }
      <li><a href={`#why-it-matters-${currentPost.id}`}>Why it matters</a></li>
    </ol>
  </details>

  <a class="article-rail-author" href={`/authors/${currentAuthor.id}/`}>
    <img src={currentAuthor.data.avatar} alt="" loading="lazy" />
    <span>
      <span class="label">Written by</span>
      <strong>{currentAuthor.data.name}</strong>
      <span>{currentAuthor.data.role}</span>
    </span>
  </a>

  <details
    class="sidebar-section sidebar-topic article-sidebar-module"
    data-mobile-sidebar
    open
    aria-labelledby={`${currentPost.id}-topic-heading`}
  >
    <summary class="sidebar-heading">
      <span class="label sidebar-eyebrow">Keep exploring</span>
      <h2 id={`${currentPost.id}-topic-heading`}>Topics in this story</h2>
    </summary>
    <nav class="article-topic-links" id={topicId} aria-label="Story topics">
      {
        currentPost.data.tags.map((tag) => (
          <a href={`/tag/${slugify(tag)}/`}>
            <span>{tag}</span>
            <span aria-hidden="true">-&gt;</span>
          </a>
        ))
      }
    </nav>
  </details>

  {
    posts.length > 0 && (
      <details
        class="sidebar-section sidebar-latest article-sidebar-module"
        data-mobile-sidebar
        open
        aria-labelledby={latestId}
      >
        <summary class="sidebar-heading">
          <span class="label sidebar-eyebrow">Fresh from the desk</span>
          <h2 id={latestId}>Latest stories</h2>
        </summary>
        <div class="latest-list">
          {posts.slice(0, 3).map((entry) => (
            <a class="latest-story" href={`/posts/${entry.id}/`}>
              <img src={entry.data.cover} alt="" loading="lazy" />
              <span class="latest-story-copy">
                <span class="latest-story-tag label">{entry.data.tags[0]}</span>
                <span class="latest-story-title">{entry.data.title}</span>
                <span class="latest-story-meta">{formatPostDate(entry.data.pubDate)}</span>
              </span>
            </a>
          ))}
        </div>
        <a class="article-sidebar-link" href="/latest/">
          See all latest <span aria-hidden="true">-&gt;</span>
        </a>
      </details>
    )
  }
</aside>
