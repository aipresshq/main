---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';
import { formatLabel } from '../lib/formats';
import { slugify } from '../lib/slug';
import CoverImage from './CoverImage.astro';

export interface Props {
  posts: CollectionEntry<'posts'>[];
  currentPost: CollectionEntry<'posts'>;
}

const { posts, currentPost } = Astro.props;

const topicId = `article-topics-${currentPost.id}`;
const latestId = `article-latest-${currentPost.id}`;
const topicLinks = [...new Set([formatLabel(currentPost.data.format), ...currentPost.data.tags])];
---

<aside class="article-sidebar" aria-label="Article sidebar" data-pagefind-ignore>
  <details
    class="sidebar-section sidebar-topic article-sidebar-module"
    data-mobile-sidebar
    open
    aria-labelledby={`${currentPost.id}-topic-heading`}
  >
    <summary class="sidebar-heading">
      <span class="label sidebar-eyebrow">Keep exploring</span>
      <h2 id={`${currentPost.id}-topic-heading`}>Topics in this story</h2>
    </summary>
    <nav class="article-topic-links" id={topicId} aria-label="Story topics">
      {
        topicLinks.map((topic) => (
          <a
            href={
              topic === formatLabel(currentPost.data.format)
                ? `/format/${currentPost.data.format}/`
                : `/tag/${slugify(topic)}/`
            }
          >
            <span>{topic}</span>
            <span aria-hidden="true">-&gt;</span>
          </a>
        ))
      }
    </nav>
  </details>

  {
    posts.length > 0 && (
      <details
        class="sidebar-section sidebar-latest article-sidebar-module"
        data-mobile-sidebar
        open
        aria-labelledby={latestId}
      >
        <summary class="sidebar-heading">
          <span class="label sidebar-eyebrow">Fresh from the desk</span>
          <h2 id={latestId}>Latest stories</h2>
        </summary>
        <div class="latest-list">
          {posts.slice(0, 3).map((entry) => (
            <a class="latest-story" href={`/posts/${entry.id}/`}>
              <CoverImage src={entry.data.cover} alt="" sizes="(max-width: 900px) 120px, 96px" />
              <span class="latest-story-copy">
                <span class="latest-story-tag label">{formatLabel(entry.data.format)}</span>
                <span class="latest-story-title">{entry.data.title}</span>
                <span class="latest-story-meta">{formatPostDate(entry.data.pubDate)}</span>
              </span>
            </a>
          ))}
        </div>
        <a class="article-sidebar-link" href="/latest/">
          See all latest <span aria-hidden="true">-&gt;</span>
        </a>
      </details>
    )
  }
</aside>
