---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';

export interface Props {
  title: string;
  description: string;
  posts: CollectionEntry<'posts'>[];
  emptyNote: string;
  substackUrl: string;
}

const { title, description, posts, emptyNote, substackUrl } = Astro.props;
const categoryId = `category-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
// The promo card takes a grid cell of its own, in the first row alongside
// the first two stories — same spot a subscribe/community card holds in
// the reference layout, rather than a separate full-height sidebar column.
const PROMO_POSITION = 2;
---

{
  posts.length > 0 ? (
    <section class="category-front" aria-labelledby={`${categoryId}-title`}>
      <header class="category-band">
        <span class="label category-band-eyebrow">AI Snap / category</span>
        <h1 id={`${categoryId}-title`}>{title}</h1>
        <p>{description}</p>
      </header>

      <div class="category-grid">
        {posts.map((post, index) => (
          <>
            {index === PROMO_POSITION && (
              <a class="category-promo" href={substackUrl}>
                <span class="label">Join our community</span>
                <strong>AI news with the useful context included.</strong>
                <span class="category-promo-link">Subscribe free <span aria-hidden="true">-&gt;</span></span>
              </a>
            )}
            <a class="category-card" href={`/posts/${post.id}/`}>
              <img src={post.data.cover} alt={post.data.coverAlt} loading="lazy" />
              <span class="category-card-topline">
                <span class="label category-card-topic">{post.data.tags[0]}</span>
                <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              </span>
              <h2>{post.data.title}</h2>
            </a>
          </>
        ))}
      </div>
    </section>
  ) : (
    <section class="category-empty">
      <h1>{title}</h1>
      <p>{emptyNote}</p>
    </section>
  )
}
