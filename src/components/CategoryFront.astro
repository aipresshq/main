---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';
import { formatLabel } from '../lib/formats';
import { readMinutes } from '../lib/read-time';
import CoverImage from './CoverImage.astro';
import { buildFormatFacets } from '../lib/facets';

export interface Props {
  title: string;
  description: string;
  posts: CollectionEntry<'posts'>[];
  emptyNote: string;
  /**
   * Every post in the archive, not just this page's. Used so the format filter
   * offers the same choices on every page and can say how many matches lie
   * beyond the one you are looking at. Defaults to `posts` for the unpaginated
   * callers (the homepage sections).
   */
  archivePosts?: CollectionEntry<'posts'>[];
  /**
   * False on page two and beyond. A continuation page is not a new front page,
   * so it must not promote its first story to lead treatment.
   */
  showLead?: boolean;
}

const { title, description, posts, emptyNote, archivePosts = posts, showLead = true } = Astro.props;
const categoryId = `category-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const featuredPost = showLead ? (posts.find((post) => post.data.featured) ?? posts[0]) : undefined;
const latestPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : posts;
const formatFacets = buildFormatFacets(archivePosts, latestPosts);
const latestDate = posts[0] ? formatPostDate(posts[0].data.pubDate) : '';
const initialVisible = 6;
---

{
  posts.length > 0 ? (
    <section
      class="category-front"
      data-category-front
      data-category-visible={initialVisible}
      aria-labelledby={`${categoryId}-title`}
    >
      <header class="category-intro">
        <div>
          <span class="label">aiPressHQ / category</span>
          <h1 id={`${categoryId}-title`}>{title}</h1>
        </div>
        <div class="category-intro-details">
          <p>{description}</p>
          <div class="category-intro-meta" aria-label={`${title} category summary`}>
            <span>
              {posts.length} {posts.length === 1 ? 'story' : 'stories'}
            </span>
            {latestDate && <span>Updated {latestDate}</span>}
          </div>
        </div>
      </header>

      <div class="category-rule" aria-hidden="true">
        <span />
      </div>

      {featuredPost && (
        <section class="category-featured" aria-labelledby={`${categoryId}-featured-title`}>
          <div class="category-featured-heading">
            <div>
              <span class="label">Featured story</span>
              <h2 id={`${categoryId}-featured-title`}>Start with the lead story</h2>
            </div>
            <span class="category-featured-count label">1 selected</span>
          </div>

          <div class="category-featured-grid">
            <a class="category-featured-lead" href={`/posts/${featuredPost.id}/`}>
              <CoverImage
                src={featuredPost.data.cover}
                alt={featuredPost.data.coverAlt}
                loading="eager"
                priority
                sizes="(max-width: 900px) 100vw, 46vw"
              />
              <span class="category-featured-copy">
                <span class="label">{formatLabel(featuredPost.data.format)}</span>
                <h3>{featuredPost.data.title}</h3>
                <p>{featuredPost.data.description}</p>
                <span class="category-featured-meta">
                  <time datetime={featuredPost.data.pubDate.toISOString()}>
                    {formatPostDate(featuredPost.data.pubDate)}
                  </time>
                  <span>{readMinutes(featuredPost)} min read</span>
                </span>
              </span>
            </a>
          </div>
        </section>
      )}

      <div class="category-layout">
        <div class="category-feed">
          <div class="category-feed-toolbar">
            <div class="category-feed-heading">
              <span class="label">Latest updates</span>
              <span class="category-feed-count" data-category-feed-count>
                {latestPosts.length} {latestPosts.length === 1 ? 'story' : 'stories'}
              </span>
            </div>
            <div class="category-feed-filters" aria-label="Filter category stories">
              <label class="category-format-filter">
                <span>Format</span>
                <select data-category-format aria-label="Filter by story format">
                  <option value="all">All formats</option>
                  {formatFacets.map((facet) => (
                    <option value={facet.key} data-facet-total={facet.total}>
                      {facet.label} ({facet.total})
                    </option>
                  ))}
                </select>
              </label>
              <label class="category-toggle">
                <span>Headlines only</span>
                <input type="checkbox" data-category-toggle aria-label="Show headlines only" />
                <span class="category-toggle-track" aria-hidden="true">
                  <span />
                </span>
              </label>
            </div>
          </div>

          {latestPosts.length > 0 ? (
            <>
              <div class="category-story-list" data-category-list>
                {latestPosts.map((post, index) => (
                  <a
                    class="category-story"
                    href={`/posts/${post.id}/`}
                    data-category-index={index}
                    data-category-format={post.data.format}
                  >
                    <CoverImage
                      src={post.data.cover}
                      alt={post.data.coverAlt}
                      sizes="(max-width: 780px) 100vw, 230px"
                    />
                    <span class="category-story-copy">
                      <span class="category-story-topline">
                        <span class="label category-story-topic">
                          {formatLabel(post.data.format)}
                        </span>
                        <time datetime={post.data.pubDate.toISOString()}>
                          {formatPostDate(post.data.pubDate)}
                        </time>
                      </span>
                      <h2>{post.data.title}</h2>
                      <span class="category-story-description">{post.data.description}</span>
                      <span class="category-story-read">{readMinutes(post)} min read</span>
                    </span>
                  </a>
                ))}
              </div>
              {latestPosts.length > initialVisible && (
                <button class="category-load-more" type="button" data-category-load-more hidden>
                  <span>Load more stories</span>
                  <span aria-hidden="true">→</span>
                </button>
              )}
            </>
          ) : (
            <p class="category-feed-empty">
              This category has one featured story. New updates will appear here as they are
              published.
            </p>
          )}
          <p class="category-feed-scope" data-category-scope hidden>
            <span data-category-scope-text />{' '}
            <a data-category-scope-link href="/latest/">
              See all
            </a>
          </p>
          {latestPosts.length > 0 && (
            <p class="category-feed-empty" data-category-filter-empty hidden>
              No stories match this filter. Try another format or show all formats.
            </p>
          )}
        </div>

        <aside class="category-rail" aria-label={`${title} editorial rail`}>
          <section class="category-signal">
            <div class="category-signal-heading">
              <span class="label">Editorial signal</span>
              <h2>Top of this desk</h2>
            </div>
            <ol>
              {posts.slice(0, 5).map((post) => (
                <li>
                  <a href={`/posts/${post.id}/`}>
                    <span class="label">{post.data.tags[0]}</span>
                    <h3>{post.data.title}</h3>
                  </a>
                </li>
              ))}
            </ol>
            <a class="category-signal-link" href="/latest/">
              See all <span aria-hidden="true">→</span>
            </a>
          </section>

          <section class="category-rail-card" aria-labelledby={`${categoryId}-explore-heading`}>
            <span class="label">Keep exploring</span>
            <strong id={`${categoryId}-explore-heading`}>Move through the desk.</strong>
            <span>Switch between the latest updates, selected stories, and usage trackers.</span>
            <nav class="category-rail-nav" aria-label="Editorial sections">
              <a href="/latest/">
                Latest updates <span aria-hidden="true">→</span>
              </a>
              <a href="/trending/">
                Editor's picks <span aria-hidden="true">→</span>
              </a>
              <a href="/trackers/">
                Usage trackers <span aria-hidden="true">→</span>
              </a>
            </nav>
          </section>
        </aside>
      </div>
    </section>
  ) : (
    <section class="category-empty">
      <span class="label">aiPressHQ / archive</span>
      <h1>{title}</h1>
      <p>{emptyNote}</p>
      <a class="category-empty-link" href="/latest/">
        Browse latest stories <span aria-hidden="true">→</span>
      </a>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-category-front]').forEach((categoryFront) => {
    const categoryToggle = categoryFront.querySelector<HTMLInputElement>('[data-category-toggle]');
    const formatFilter = categoryFront.querySelector<HTMLSelectElement>('[data-category-format]');
    const feedCount = categoryFront.querySelector<HTMLElement>('[data-category-feed-count]');
    const filterEmpty = categoryFront.querySelector<HTMLElement>('[data-category-filter-empty]');
    const loadMore = categoryFront.querySelector<HTMLButtonElement>('[data-category-load-more]');
    const storyList = categoryFront.querySelector<HTMLElement>('[data-category-list]');
    const scope = categoryFront.querySelector<HTMLElement>('[data-category-scope]');
    const scopeText = categoryFront.querySelector<HTMLElement>('[data-category-scope-text]');
    const scopeLink = categoryFront.querySelector<HTMLAnchorElement>('[data-category-scope-link]');
    const initialVisible = Number(categoryFront.dataset.categoryVisible ?? 6);
    const stories = storyList
      ? [...storyList.querySelectorAll<HTMLElement>('.category-story')]
      : [];
    let expanded = false;

    /**
     * Keeps the chosen format in the URL.
     *
     * This filter only ever sees the stories in the DOM, which since archives
     * paginated is one page of them. Putting the choice in the query string means
     * a narrowed view can be shared and restored; `updateScopeNote` covers the
     * other half by admitting when matches exist beyond this page.
     */
    const syncUrl = (format: string) => {
      const url = new URL(window.location.href);
      if (format === 'all') url.searchParams.delete('format');
      else url.searchParams.set('format', format);
      window.history.replaceState({}, '', url);
    };

    const updateScopeNote = (format: string, visibleMatches: number) => {
      if (!scope || !scopeText || !scopeLink) return;
      const option = formatFilter?.selectedOptions[0];
      const total = Number(option?.dataset.facetTotal ?? 0);

      // Only worth saying when the archive holds more than this page can show.
      if (format === 'all' || !total || total <= visibleMatches) {
        scope.hidden = true;
        return;
      }
      const label = option?.textContent?.replace(/\s*\(\d+\)\s*$/, '').trim() ?? format;
      scopeText.textContent = `Showing ${visibleMatches} of ${total} ${label} stories on this page.`;
      scopeLink.href = `/format/${format}/`;
      scopeLink.textContent = `See all ${total}`;
      scope.hidden = false;
    };

    const updateFilters = () => {
      const selectedFormat = formatFilter?.value ?? 'all';
      const matchingStories = stories.filter(
        (story) => selectedFormat === 'all' || story.dataset.categoryFormat === selectedFormat,
      );
      const matchingSet = new Set(matchingStories);

      stories.forEach((story) => {
        const isVisible =
          matchingSet.has(story) && (expanded || matchingStories.indexOf(story) < initialVisible);
        story.hidden = !isVisible;
      });

      if (feedCount) {
        const count = matchingStories.length;
        feedCount.textContent = `${count} ${count === 1 ? 'story' : 'stories'}`;
      }
      if (filterEmpty) filterEmpty.hidden = matchingStories.length > 0;
      if (loadMore) loadMore.hidden = expanded || matchingStories.length <= initialVisible;
      categoryFront.classList.toggle(
        'category-front--headlines-only',
        categoryToggle?.checked ?? false,
      );
      updateScopeNote(selectedFormat, matchingStories.length);
    };

    // Restore a shared or bookmarked filter before the first paint of the list.
    const requested = new URL(window.location.href).searchParams.get('format');
    if (requested && formatFilter?.querySelector(`option[value="${CSS.escape(requested)}"]`)) {
      formatFilter.value = requested;
    }

    formatFilter?.addEventListener('change', () => {
      expanded = false;
      syncUrl(formatFilter.value);
      updateFilters();
    });
    categoryToggle?.addEventListener('change', updateFilters);
    loadMore?.addEventListener('click', () => {
      expanded = true;
      updateFilters();
    });
    updateFilters();
  });
</script>
