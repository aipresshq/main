---
import type { CollectionEntry } from 'astro:content';
import Byline from './Byline.astro';
import Icon from './Icon.astro';

export interface Props {
  post: CollectionEntry<'posts'>;
  rank: number;
}

const { post, rank } = Astro.props;
const { title, description, author, cover, coverAlt, tags } = post.data;
---

<a class="photo-card hero-card" href={`/posts/${post.id}/`}>
	<img src={cover} alt={coverAlt} />
	<div class="overlay"></div>
	<span class="badge">
		<span class="badge-icon"><Icon name="bolt" size={12} /></span>
		Trending #{rank}
	</span>
	<div class="content">
		<Byline author={author} category={tags[0]} onDark />
		<h3>{title}</h3>
		<p class="hero-dek">{description}</p>
	</div>
</a>
