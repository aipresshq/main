---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from './SectionHeader.astro';

export interface Props {
  title: string;
  href?: string;
  /** Lead story first, then the text-only rows beside it. */
  posts: CollectionEntry<'posts'>[];
}

const { title, href, posts } = Astro.props;
const [lead, ...rest] = posts;
const rows = rest.slice(0, 4);
---

<section class="section reveal">
	<SectionHeader title={title} href={href} />

	<div class="split">
		<a class="split-lead" href={`/posts/${lead.id}/`}>
			<img src={lead.data.cover} alt={lead.data.coverAlt} />
			<span class="label split-topic">{lead.data.tags[0]}</span>
			<h3>{lead.data.title}</h3>
			<p>{lead.data.description}</p>
		</a>

		{
			rows.length > 0 && (
				<ol class="split-rows">
					{rows.map((post) => (
						<li>
							<a href={`/posts/${post.id}/`}>
								<span class="label split-topic">{post.data.tags[0]}</span>
								<h3>{post.data.title}</h3>
							</a>
						</li>
					))}
				</ol>
			)
		}
	</div>
</section>
