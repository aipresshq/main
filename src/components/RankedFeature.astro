---
import { getEntry, type CollectionEntry } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import { formatPostDate } from '../lib/date';
import { readMinutes } from '../lib/read-time';
import { getAuthorId } from '../lib/author-reference';

export interface Props {
  title: string;
  href?: string;
  /** First three render as photo cards; the rest as the text-only column. */
  posts: CollectionEntry<'posts'>[];
}

const { title, href, posts } = Astro.props;
const postsWithAuthors = await Promise.all(posts.map(async (post) => {
  const authorId = getAuthorId(post.data.author);
  const author = await getEntry('authors', authorId);
  if (!author) {
    throw new Error(`Missing author profile for post: ${post.id} (author: ${authorId})`);
  }
  return { post, author };
}));
const cards = postsWithAuthors.slice(0, 3);
const listed = postsWithAuthors.slice(3, 6);
---

<section class="panel">
	<SectionHeader title={title} href={href} />

	<div class="ranked-grid">
		{
			cards.map(({ post, author }) => (
				<a class="ranked-card" href={`/posts/${post.id}/`}>
					<img src={post.data.cover} alt={post.data.coverAlt} />
					<span class="label ranked-topic">{post.data.tags[0]}</span>
					<h3>{post.data.title}</h3>
					<span class="ranked-byline">
						<span>{author.data.name}</span>
						<span class="label">{readMinutes(post)} min read</span>
					</span>
				</a>
			))
		}

		{
			listed.length > 0 && (
				<ul class="ranked-list">
					{listed.map(({ post, author }) => (
						<li>
							<a href={`/posts/${post.id}/`}>
								<span class="label ranked-topic">{post.data.tags[0]}</span>
								<h3>{post.data.title}</h3>
								<span class="ranked-byline">
									<span>{author.data.name}</span>
									<span class="label">{formatPostDate(post.data.pubDate)}</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</section>
