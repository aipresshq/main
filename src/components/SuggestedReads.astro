---
import type { CollectionEntry } from 'astro:content';
import { formatLabel } from '../lib/formats';
import { readMinutes } from '../lib/read-time';
import CoverImage from './CoverImage.astro';

export type Props =
  | {
      posts: CollectionEntry<'posts'>[];
      variant?: 'standalone';
      articleId?: string;
    }
  | {
      posts: CollectionEntry<'posts'>[];
      variant: 'stream';
      articleId: string;
    };

const { posts, variant = 'standalone', articleId } = Astro.props;
const headingId = `suggested-reads-${articleId ?? variant}`;
---

{
  posts.length > 0 && (
    <section
      class:list={['suggested-reads', `suggested-reads--${variant}`]}
      aria-labelledby={headingId}
    >
      <div class="suggested-reads-heading">
        <span class="label">Continue reading</span>
        <h2 id={headingId}>Suggested Reads</h2>
      </div>

      <div class="suggested-reads-grid">
        {posts.map((post) => (
          <a class="suggested-story" href={`/posts/${post.id}/`}>
            <CoverImage
              src={post.data.cover}
              alt={post.data.coverAlt}
              sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 25vw"
            />
            <span class="suggested-story-body">
              <span class="label suggested-story-tag">{formatLabel(post.data.format)}</span>
              <span class="suggested-story-title">{post.data.title}</span>
              <span class="suggested-story-meta">{readMinutes(post)} min read</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}
