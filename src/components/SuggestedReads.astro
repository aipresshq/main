---
import type { CollectionEntry } from 'astro:content';

export type Props =
  | {
      posts: CollectionEntry<'posts'>[];
      variant?: 'standalone';
      articleId?: string;
    }
  | {
      posts: CollectionEntry<'posts'>[];
      variant: 'stream';
      articleId: string;
    };

const { posts, variant = 'standalone', articleId } = Astro.props;
const headingId = `suggested-reads-${articleId ?? variant}`;
---

{
  posts.length > 0 && (
    <section class:list={['suggested-reads', `suggested-reads--${variant}`]} aria-labelledby={headingId}>
      <div class="suggested-reads-heading">
        <span class="label">Continue reading</span>
        <h2 id={headingId}>Suggested Reads</h2>
      </div>

      <div class="suggested-reads-grid">
        {posts.map((post) => (
          <a class="suggested-story" href={`/posts/${post.id}/`}>
            <img src={post.data.cover} alt={post.data.coverAlt} loading="lazy" />
            <span class="suggested-story-body">
              <span class="label suggested-story-tag">{post.data.tags[0]}</span>
              <span class="suggested-story-title">{post.data.title}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}
