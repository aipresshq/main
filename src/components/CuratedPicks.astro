---
import type { CollectionEntry } from 'astro:content';
import Byline from './Byline.astro';
import Icon from './Icon.astro';
import { formatPostDate } from '../lib/date';

export interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;

function readMinutes(post: CollectionEntry<'posts'>): number {
  return Math.max(1, Math.round(post.body.split(/\s+/).length / 200));
}
---

<div class="curated-picks">
	<h4 class="rail-heading">Curated Picks</h4>
	<div class="curated-list">
		{
			posts.slice(0, 3).map((post) => (
				<a href={`/posts/${post.id}/`} class="curated-item">
					<Byline author={post.data.author} category={post.data.tags[0]} />
					<div class="curated-body">
						<h5 class="curated-title">{post.data.title}</h5>
						<img src={post.data.cover} alt="" class="curated-thumb" />
					</div>
					<div class="meta-row">
						<span class="meta-item">
							<Icon name="calendar" size={13} />
							{formatPostDate(post.data.pubDate)}
						</span>
						<span class="meta-item">
							<Icon name="eye" size={13} />
							{readMinutes(post)} min read
						</span>
						<span class="meta-bookmark" aria-hidden="true">
							<Icon name="bookmark" size={15} />
						</span>
					</div>
				</a>
			))
		}
	</div>
</div>
