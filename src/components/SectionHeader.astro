---
export interface Props {
  title: string;
  /** Optional "view all" destination. */
  href?: string;
}

const { title, href } = Astro.props;
---

<div class="section-head home-section-heading">
  <h2 class="section-title home-section-heading-title">{title}</h2>
  {
    href && (
      <a class="section-link home-section-heading-link" href={href}>
        View all <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>
