---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';

export interface DeskColumn {
  title: string;
  href?: string;
  posts: CollectionEntry<'posts'>[];
}

export interface Props {
  columns: DeskColumn[];
  signalPosts: CollectionEntry<'posts'>[];
}

const { columns, signalPosts } = Astro.props;
const visibleColumns = columns.filter((column) => column.posts.length > 0);
const signal = signalPosts.slice(0, 4);
---

{
  visibleColumns.length > 0 && (
    <section class="desk-index" aria-labelledby="desk-index-heading">
      <div class="desk-index-head home-section-heading">
        <div>
          <span class="label">Browse the coverage</span>
          <h2 class="home-section-heading-title" id="desk-index-heading">
            Find your next read
          </h2>
        </div>
        <a class="desk-index-link home-section-heading-link" href="/latest/">
          View all latest <span aria-hidden="true">-&gt;</span>
        </a>
      </div>

      <div class="desk-index-layout">
        <div class="desk-index-columns">
          {visibleColumns.map((column) => (
            <section
              class="desk-index-column"
              aria-labelledby={`desk-${column.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            >
              <div class="desk-index-column-head">
                <h3 id={`desk-${column.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
                  {column.title}
                </h3>
                {column.href && (
                  <a href={column.href} aria-label={`See all ${column.title}`}>
                    <span aria-hidden="true">-&gt;</span>
                  </a>
                )}
              </div>

              <div class="desk-index-list">
                {column.posts.slice(0, 3).map((post) => (
                  <a class="desk-index-story" href={`/posts/${post.id}/`}>
                    <h4>{post.data.title}</h4>
                    <div class="desk-index-story-meta">
                      <span class="label">{post.data.tags[0]}</span>
                      <time datetime={post.data.pubDate.toISOString()}>
                        {formatPostDate(post.data.pubDate)}
                      </time>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <aside class="desk-index-signal" aria-label="Editor's signal">
          <div class="desk-index-signal-head">
            <span class="label">Editor's signal</span>
            <strong>Stories worth opening.</strong>
          </div>
          <ol class="desk-index-signal-list">
            {signal.map((post, index) => (
              <li>
                <span class="desk-index-signal-rank">{String(index + 1).padStart(2, '0')}</span>
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ol>
          <a class="desk-index-signal-link" href="/trending/">
            Browse selected stories <span aria-hidden="true">-&gt;</span>
          </a>
        </aside>
      </div>
    </section>
  )
}
