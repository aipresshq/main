---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';
import CoverImage from './CoverImage.astro';

export interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const stories = posts.slice(0, 6);
---

{
  stories.length > 0 && (
    <section class="latest-section" aria-labelledby="latest-section-heading">
      <div class="latest-section-head home-section-heading">
        <div>
          <span class="label latest-section-kicker">Fresh from the desk</span>
          <h2 class="home-section-heading-title" id="latest-section-heading">
            Latest
          </h2>
        </div>
        <a class="latest-section-link home-section-heading-link" href="/latest/">
          View all latest <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="latest-section-layout">
        <div class="latest-story-grid">
          {stories.map((post) => (
            <a class="latest-story-card" href={`/posts/${post.id}/`}>
              <CoverImage
                src={post.data.cover}
                alt={post.data.coverAlt}
                sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 25vw"
              />
              <div class="latest-story-meta">
                <span class="label">{post.data.tags[0]}</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatPostDate(post.data.pubDate)}
                </time>
              </div>
              <h3>{post.data.title}</h3>
            </a>
          ))}
        </div>

        <aside class="latest-section-rail" aria-label="aiPressHQ editorial links">
          <section class="latest-focus-card" aria-labelledby="latest-focus-heading">
            <span class="label">Coverage map</span>
            <h3 id="latest-focus-heading">Go deeper by desk.</h3>
            <p>
              Move from the latest updates into the labs, launches, and comparisons behind the
              headlines.
            </p>
            <nav aria-label="Coverage map links">
              <a href="/tag/openai/">
                AI labs <span aria-hidden="true">→</span>
              </a>
              <a href="/tag/product-launch/">
                Product launches <span aria-hidden="true">→</span>
              </a>
              <a href="/tag/comparisons/">
                Research and comparisons <span aria-hidden="true">→</span>
              </a>
            </nav>
          </section>

          <div class="latest-edition-card">
            <span class="label">Explore the edition</span>
            <h3>Keep following the stories that matter.</h3>
            <nav aria-label="Edition sections">
              <a href="/trending/">
                Trending stories <span aria-hidden="true">→</span>
              </a>
              <a href="/trackers/">
                Usage trackers <span aria-hidden="true">→</span>
              </a>
              <a href="/tag/openai/">
                OpenAI coverage <span aria-hidden="true">→</span>
              </a>
            </nav>
          </div>
        </aside>
      </div>
    </section>
  )
}
