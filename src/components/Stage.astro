---
import { getEntry, type CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';
import { readMinutes } from '../lib/read-time';
import { getAuthorId } from '../lib/author-reference';
import CoverImage from './CoverImage.astro';

export interface Props {
  /** Reverse-chronological posts: supplies the lead story and the Just In list. */
  posts: CollectionEntry<'posts'>[];
  /** Featured posts: supplies the Editor's Pick column. */
  picks: CollectionEntry<'posts'>[];
  /** Shown when the view has no posts at all. */
  emptyNote: string;
}

const { posts, picks, emptyNote } = Astro.props;
const [lead, ...rest] = posts;
const editorPicks = picks.filter((p) => p.id !== lead?.id).slice(0, 2);
const justIn = rest.slice(0, 5);

async function withAuthor(post: CollectionEntry<'posts'>) {
  const authorId = getAuthorId(post.data.author);
  const author = await getEntry('authors', authorId);
  if (!author) {
    throw new Error(`Missing author profile for post: ${post.id} (author: ${authorId})`);
  }
  return { post, author };
}

const leadWithAuthor = lead && (await withAuthor(lead));
const picksWithAuthors = await Promise.all(editorPicks.map(withAuthor));
---

{
  leadWithAuthor ? (
    <section
      class:list={[
        'hero',
        // The grid declares one track per optional column. Without this the lead
        // dropped into the narrow track reserved for picks and the unused track
        // stayed on the page as empty space.
        `hero--columns-${1 + (picksWithAuthors.length > 0 ? 1 : 0) + (justIn.length > 0 ? 1 : 0)}`,
      ]}
      aria-label="Top stories"
    >
      {picksWithAuthors.length > 0 && (
        <div class="hero-picks">
          <div class="hero-column-head">
            <h2>Editor's Pick</h2>
          </div>
          {picksWithAuthors.map(({ post, author }) => (
            <a class="hero-pick-card" href={`/posts/${post.id}/`}>
              <CoverImage
                src={post.data.cover}
                alt={post.data.coverAlt}
                sizes="(max-width: 900px) 50vw, 25vw"
              />
              <span class="label hero-pick-topic">{post.data.tags[0]}</span>
              <h3>{post.data.title}</h3>
              <span class="hero-pick-meta">
                <span>{author.data.name}</span>
                <span>{readMinutes(post)} min read</span>
              </span>
            </a>
          ))}
        </div>
      )}

      <div class="hero-lead">
        <span class="label hero-lead-topic">{leadWithAuthor.post.data.tags[0]}</span>
        <h1 class="hero-lead-headline">
          <a href={`/posts/${leadWithAuthor.post.id}/`}>{leadWithAuthor.post.data.title}</a>
        </h1>
        <div class="hero-lead-meta">
          <span class="byline">
            <span class="byline-avatar" aria-hidden="true">
              {leadWithAuthor.author.data.name.charAt(0)}
            </span>
            <span class="byline-name">By {leadWithAuthor.author.data.name}</span>
          </span>
          <time class="label" datetime={leadWithAuthor.post.data.pubDate.toISOString()}>
            {formatPostDate(leadWithAuthor.post.data.pubDate)}
          </time>
          <span class="label">{readMinutes(leadWithAuthor.post)} min read</span>
        </div>
        <a class="hero-lead-image" href={`/posts/${leadWithAuthor.post.id}/`}>
          <CoverImage
            src={leadWithAuthor.post.data.cover}
            alt={leadWithAuthor.post.data.coverAlt}
            loading="eager"
            priority
            sizes="(max-width: 900px) 100vw, 55vw"
          />
        </a>
      </div>

      {justIn.length > 0 && (
        <aside class="hero-just-in" aria-label="Just in">
          <div class="hero-column-head">
            <span class="hero-live-dot" aria-hidden="true" />
            <h2>Just In</h2>
            <a class="hero-just-in-link" href="/latest/" aria-label="View all latest stories">
              <svg
                width="14"
                height="10"
                viewBox="0 0 14 10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M1 5h11.5M8 1l4.5 4-4.5 4" />
              </svg>
            </a>
          </div>
          <ul>
            {justIn.map((post) => (
              <li>
                <a href={`/posts/${post.id}/`}>
                  <span class="label hero-just-in-topic">{post.data.tags[0]}</span>
                  <h3>{post.data.title}</h3>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </section>
  ) : (
    <section class="more-stories">
      <p class="empty-note">{emptyNote}</p>
    </section>
  )
}
