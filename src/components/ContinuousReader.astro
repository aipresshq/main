---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  currentPost: CollectionEntry<'posts'>;
  nextPost?: CollectionEntry<'posts'>;
}

const { currentPost, nextPost } = Astro.props;
---

<div
  class="continuous-stream"
  data-continuous-stream
  data-continuous-reader
  aria-busy="false"
  data-current-post={currentPost.id}
>
  <slot />

  {
    nextPost && (
      <>
        <section class="continuous-transition" aria-label="Next story">
          <span class="label">Next Story</span>
          <a class="continuous-next-link" href={`/posts/${nextPost.id}/`}>{nextPost.data.title}</a>
          <div class="continuous-sentinel" data-next-fragment={`/posts/${nextPost.id}/fragment/`} aria-hidden="true"></div>
        </section>
      </>
    )
  }

  <p class="continuous-status" aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import { initContinuousReader } from '../scripts/continuous-reader';

  if ('IntersectionObserver' in window) {
    document.querySelectorAll('[data-continuous-stream]').forEach((root) => {
      if (root instanceof HTMLElement) initContinuousReader(root);
    });
  }
</script>
