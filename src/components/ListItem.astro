---
import type { CollectionEntry } from 'astro:content';
import Byline from './Byline.astro';
import Icon from './Icon.astro';
import { formatPostDate } from '../lib/date';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, author, pubDate, cover, coverAlt, tags } = post.data;
const readMinutes = Math.max(1, Math.round(post.body.split(/\s+/).length / 200));
---

<a class="list-card" href={`/posts/${post.id}/`}>
	<img class="list-card-thumb" src={cover} alt={coverAlt} />
	<div class="list-card-body">
		<Byline author={author} category={tags[0]} />
		<h3 class="list-card-title">{title}</h3>
		<p class="list-card-dek">{description}</p>
		<div class="meta-row">
			<span class="meta-item">
				<Icon name="calendar" size={13} />
				{formatPostDate(pubDate)}
			</span>
			<span class="meta-item">
				<Icon name="eye" size={13} />
				{readMinutes} min read
			</span>
			<span class="meta-bookmark" aria-hidden="true">
				<Icon name="bookmark" size={15} />
			</span>
		</div>
	</div>
</a>
