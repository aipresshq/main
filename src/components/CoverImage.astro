---
import { Image } from 'astro:assets';

export interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  loading = 'lazy',
  priority = false,
  sizes = '(max-width: 780px) 100vw, 50vw',
  class: className,
} = Astro.props;

const imageClass = ['responsive-image', className].filter(Boolean).join(' ');
---

<Image
  class={imageClass}
  src={src}
  inferSize
  widths={[400, 800, 1200, 1600]}
  sizes={sizes}
  alt={alt}
  loading={loading}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
/>
