---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import CoverImage from './CoverImage.astro';

export interface Props {
  title: string;
  href?: string;
  posts: CollectionEntry<'posts'>[];
}

const { title, href, posts } = Astro.props;
---

<section class="section">
  <SectionHeader title={title} href={href} />

  <div class="headline-grid">
    {
      posts.map((post) => (
        <a class="headline-item" href={`/posts/${post.id}/`}>
          <CoverImage
            src={post.data.cover}
            alt={post.data.coverAlt}
            sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 25vw"
          />
          <span class="label headline-topic">{post.data.tags[0]}</span>
          <h3>{post.data.title}</h3>
        </a>
      ))
    }
  </div>
</section>
