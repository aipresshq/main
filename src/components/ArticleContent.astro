---
import { render, type CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/date';
import { formatLabel } from '../lib/formats';
import { readMinutes } from '../lib/read-time';
import { slugify } from '../lib/slug';
import CoverImage from './CoverImage.astro';

export interface Props {
  post: CollectionEntry<'posts'>;
  author: CollectionEntry<'authors'>;
  mode?: 'standalone' | 'stream';
}

const { post, author, mode = 'standalone' } = Astro.props;
const { Content } = await render(post);
const {
  title,
  description,
  pubDate,
  updatedDate,
  format,
  cover,
  coverAlt,
  coverCredit,
  takeaways,
  factsTable,
  tags,
} = post.data;
const formatName = formatLabel(format);
const topicName = tags.find((tag) => tag.toLowerCase() !== formatName.toLowerCase());
const hasDistinctUpdate = updatedDate && updatedDate.getTime() !== pubDate.getTime();
---

<article
  id={`article-${post.id}`}
  class:list={['article', { 'stream-article': mode === 'stream' }]}
  data-post-id={post.id}
  data-post-url={`/posts/${post.id}/`}
  aria-labelledby={`article-title-${post.id}`}
  data-pagefind-body={mode === 'standalone' ? true : undefined}
>
  <header class="article-header">
    <div class="article-kickers">
      <a class="label article-kicker" href={`/format/${format}/`}>{formatName}</a>
      {
        topicName && (
          <a class="label article-topic-kicker" href={`/tag/${slugify(topicName)}/`}>
            {topicName}
          </a>
        )
      }
    </div>
    <h1 id={`article-title-${post.id}`} class="article-title">{title}</h1>
    <p class="article-standfirst">{description}</p>

    <div class="article-meta">
      <a class="byline article-byline" href={`/authors/${author.id}/`}>
        <img
          class="byline-avatar"
          src={author.data.avatar}
          alt=""
          width="60"
          height="60"
          loading="lazy"
          decoding="async"
        />
        <span class="byline-copy">
          <span class="byline-name">{author.data.name}</span>
          <span class="byline-role">{author.data.role}</span>
        </span>
      </a>
      <div class="article-meta-details">
        <span class="label">
          <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
          {hasDistinctUpdate && <> · Updated {formatPostDate(updatedDate)}</>}
          {' · '}{readMinutes(post)} min read
        </span>
      </div>
      <div class="article-actions" aria-label="Story actions">
        <button
          class="article-bookmark"
          type="button"
          data-bookmark-toggle
          data-bookmark-id={post.id}
          data-bookmark-title={title}
          data-bookmark-url={`/posts/${post.id}/`}
          data-bookmark-cover={cover}
          data-bookmark-topic={tags[0]}
          data-bookmark-date={pubDate.toISOString()}
          aria-pressed="false"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 3.5h12a1 1 0 0 1 1 1v16l-7-4-7 4v-16a1 1 0 0 1 1-1Z"></path>
          </svg>
          <span data-bookmark-label>Save</span>
        </button>
        <button
          class="article-share"
          type="button"
          data-share-story
          data-share-title={title}
          data-share-url={`/posts/${post.id}/`}
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="18" cy="5" r="2.5"></circle>
            <circle cx="6" cy="12" r="2.5"></circle>
            <circle cx="18" cy="19" r="2.5"></circle>
            <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"></path>
          </svg>
          <span data-share-label>Share</span>
        </button>
      </div>
    </div>

    <section class="article-takeaways" aria-labelledby={`takeaways-${post.id}`}>
      <div class="article-takeaways-heading">
        <span class="label">At a glance</span>
        <h2 id={`takeaways-${post.id}`}>The short version</h2>
      </div>
      <ul>
        {takeaways.map((takeaway) => <li>{takeaway}</li>)}
      </ul>
    </section>
  </header>

  <figure class="article-figure">
    <CoverImage
      src={cover}
      alt={coverAlt}
      loading={mode === 'standalone' ? 'eager' : 'lazy'}
      priority={mode === 'standalone'}
      sizes="(max-width: 900px) 100vw, min(720px, 62vw)"
    />
    {coverCredit && <figcaption>{coverCredit}</figcaption>}
  </figure>

  <div class="article-measure">
    <div class="prose">
      <Content />

      {
        factsTable && (
          <aside class="article-facts" aria-labelledby={`key-facts-${post.id}`}>
            <div class="article-facts-heading">
              <span class="label">At a glance</span>
              <h3 id={`key-facts-${post.id}`}>Key facts</h3>
            </div>
            <div class="table-scroll">
              <table class="article-facts-table">
                <colgroup>
                  {factsTable.columns.map((_, index) => (
                    <col class={`article-facts-col article-facts-col-${index + 1}`} />
                  ))}
                </colgroup>
                <thead>
                  <tr>
                    {factsTable.columns.map((col) => (
                      <th scope="col">{col}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {factsTable.rows.map((row) => (
                    <tr>
                      {row.map((cell, index) =>
                        index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </aside>
        )
      }
    </div>

    <footer class="article-footer">
      <ul class="article-tags">
        {
          tags.map((tag) => (
            <li>
              <a class="pill" href={`/tag/${slugify(tag)}/`}>
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </footer>
  </div>
</article>
