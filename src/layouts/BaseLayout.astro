---
import '@fontsource-variable/inter';
import '@fontsource-variable/playfair-display';
import '@fontsource/unifrakturmaguntia';
import '../styles/global.css';
import { slugify } from '../lib/slug';

export interface Props {
  title: string;
  description?: string;
  activeTab?: 'latest' | 'trending' | 'trackers' | null;
  activeTag?: string | null;
  tags: string[];
  /** Dateline shown in the masthead — the latest story's date. */
  editionDate?: string;
}

const {
  title,
  description,
  activeTab = null,
  activeTag = null,
  tags,
  editionDate,
} = Astro.props;

const substackUrl = import.meta.env.PUBLIC_SUBSTACK_URL || 'https://aisnap.substack.com';

const sections = [
  { label: 'Latest', href: '/', active: activeTab === 'latest' },
  { label: 'Trending', href: '/trending/', active: activeTab === 'trending' },
  { label: 'Trackers', href: '/trackers/', active: activeTab === 'trackers' },
];

// A tag can share a section's name (e.g. the "Trackers" tag alongside the
// /trackers/ section). Showing both renders two identical-looking nav items
// pointing at different routes, so the tag is dropped from the nav — its
// /tag/<slug>/ page still exists and stays reachable and indexable.
const sectionLabels = new Set(sections.map((s) => s.label.toLowerCase()));
const navTags = tags.filter((tag) => !sectionLabels.has(tag.toLowerCase()));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
	</head>
	<body>
		<div class="frame">
			<header class="topbar" data-pagefind-ignore>
				<div class="topbar-left">
					<!-- Native disclosure: a full-screen section/topic menu with no
					     JavaScript. CSS swaps the hamburger for a close mark on open. -->
					<details class="menu">
						<summary class="icon-button" aria-label="Browse sections and topics">
							<svg class="icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
								<line x1="3" y1="7" x2="21" y2="7" />
								<line x1="3" y1="12" x2="21" y2="12" />
								<line x1="3" y1="17" x2="21" y2="17" />
							</svg>
							<svg class="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
								<line x1="5" y1="5" x2="19" y2="19" />
								<line x1="19" y1="5" x2="5" y2="19" />
							</svg>
						</summary>
						<div class="menu-panel">
							<div class="menu-grid">
								<section class="menu-topics">
									<h2>Topics</h2>
									<ul class="menu-columns">
										{tags.map((tag) => <li><a href={`/tag/${slugify(tag)}/`}>{tag}</a></li>)}
									</ul>
								</section>
								<section class="menu-more">
									<h2>More from AI Snap</h2>
									<ul>
										{sections.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
										<li><a href={substackUrl}>Newsletter</a></li>
									</ul>
								</section>
							</div>
						</div>
					</details>
					{editionDate && <span class="edition-date">{editionDate}</span>}
				</div>

				<a href="/" class="masthead">AI Snap</a>

				<div class="topbar-right">
					<div class="search-box">
						<svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input type="search" id="search-input" placeholder="Search" aria-label="Search stories" />
						<div id="search-results"></div>
					</div>
					<a class="subscribe-button" href={substackUrl}>Subscribe now</a>
				</div>
			</header>

			<nav class="section-nav" aria-label="Sections and topics" data-pagefind-ignore>
				{sections.map((s) => <a href={s.href} class={s.active ? 'active' : ''}>{s.label}</a>)}
				{
					navTags.map((tag) => (
						<a
							href={`/tag/${slugify(tag)}/`}
							class={activeTag?.toLowerCase() === tag.toLowerCase() ? 'active' : ''}
						>
							{tag}
						</a>
					))
				}
			</nav>

			<slot />
		</div>

		<script is:inline>
			// Zero-JS-by-default search: nothing is fetched until the visitor types.
			// Pagefind's raw API is dynamically imported (and initialized) once, on
			// first interaction, rather than shipping its prebuilt UI bundle eagerly.
			//
			// is:inline is required: a processed script gets its dynamic import
			// rewritten by Vite into a preload helper referencing an unresolved
			// __VITE_PRELOAD__ marker, which throws on the first keystroke.
			const input = document.getElementById('search-input');
			const resultsEl = document.getElementById('search-results');

			let pagefindPromise;
			function loadPagefind() {
				if (!pagefindPromise) {
					pagefindPromise = import('/pagefind/pagefind.js').then(async (mod) => {
						await mod.init();
						return mod;
					});
				}
				return pagefindPromise;
			}

			async function renderResults(query) {
				if (!resultsEl) return;
				if (!query) {
					resultsEl.innerHTML = '';
					return;
				}
				const pagefind = await loadPagefind();
				const search = await pagefind.search(query);
				const entries = await Promise.all(search.results.slice(0, 10).map((result) => result.data()));
				resultsEl.innerHTML = entries
					.map(
						(entry) =>
							`<a class="search-result" href="${entry.url}"><strong>${entry.meta?.title ?? entry.url}</strong><span>${entry.excerpt ?? ''}</span></a>`
					)
					.join('');
			}

			let debounceTimer;
			input?.addEventListener('input', (event) => {
				const query = event.target.value.trim();
				clearTimeout(debounceTimer);
				debounceTimer = setTimeout(() => renderResults(query), 200);
			});
		</script>
	</body>
</html>
