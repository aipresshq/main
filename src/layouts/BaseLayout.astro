---
import '@fontsource-variable/inter';
import '@fontsource/source-serif-4';
import '@fontsource/unifrakturmaguntia';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { slugify } from '../lib/slug';
import { topicGroups, knownTopics } from '../lib/topics';

export interface Props {
  title: string;
  description?: string;
  activeTab?: 'latest' | 'trending' | 'trackers' | null;
  activeTag?: string | null;
  /**
   * Dateline shown in the masthead. Server-rendered fallback only (the
   * latest story's date, so it's still meaningful without JS) — corrected
   * client-side to the visitor's actual current date on load, since a
   * static build can never know "today" for someone loading the page days
   * after it was built.
   */
  editionDate?: string;
}

const { title, description, activeTab = null, activeTag = null, editionDate } = Astro.props;

const sections = [
  { label: 'Latest', href: '/latest/', active: activeTab === 'latest' },
  { label: 'Trending', href: '/trending/', active: activeTab === 'trending' },
  { label: 'Tutorials', href: '/tag/tutorials/', active: activeTag?.toLowerCase() === 'tutorials' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('ai-snap-theme');
          const system = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
          document.documentElement.dataset.theme =
            stored === 'dark' || stored === 'light' ? stored : system;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <div class="reading-progress" data-reading-progress aria-hidden="true"><span></span></div>
    <div class="frame">
      <header class="site-header" data-pagefind-ignore>
        <div class="dateline-strip">
          <span class="label">AI news / daily edition</span>
          {editionDate && <span class="edition-date">{editionDate}</span>}
        </div>
      </header>

      <!-- A sibling of <header>, not nested inside it: position: sticky is bounded
			     by its containing block, and <header> is just the thin dateline strip —
			     nesting the bar there would leave it nowhere to stick once that short
			     box scrolled past. As a sibling, it can stay pinned for the full scroll
			     of the page. -->
      <nav class="primary-bar" aria-label="Primary" data-pagefind-ignore>
        <a href="/" class="masthead-mark" aria-label="AI Snap home">AI Snap</a>

        <div class="primary-bar-nav">
          <div class="section-links">
            {
              sections.map((s) => (
                <a href={s.href} aria-current={s.active ? 'page' : undefined}>
                  {s.label}
                </a>
              ))
            }
          </div>
          <details class="category-menu">
            <summary>
              <span>Categories</span>
              <svg
                class="category-menu-glyph"
                width="12"
                height="8"
                viewBox="0 0 12 8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="m1 1.5 5 5 5-5"></path>
              </svg>
            </summary>
            <div class="category-menu-panel">
              <div class="category-menu-panel-head">
                <h2>Browse categories</h2>
                <span class="category-menu-panel-count">{knownTopics.length} categories</span>
              </div>
              <div class="category-menu-groups">
                {
                  topicGroups.map((group) => (
                    <div class="category-menu-group">
                      <h3>{group.label}</h3>
                      <ul>
                        {group.topics.map((tag) => (
                          <li>
                            <a
                              href={`/tag/${slugify(tag)}/`}
                              aria-current={
                                activeTag?.toLowerCase() === tag.toLowerCase() ? 'page' : undefined
                              }
                            >
                              {tag}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          </details>
        </div>

        <div class="primary-bar-actions">
          <div class="search-box" data-search-box>
            <svg
              class="search-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="search-input"
              placeholder="Search stories"
              aria-label="Search stories"
              aria-controls="search-results"
              aria-expanded="false"
              aria-autocomplete="list"
              role="combobox"
              autocomplete="off"
              spellcheck="false"
            />
            <kbd class="search-box-key" aria-hidden="true">/</kbd>
            <div
              class="search-results"
              id="search-results"
              role="listbox"
              aria-label="Search results"
            >
            </div>
          </div>

          <details class="saved-menu" data-saved-menu>
            <summary class="saved-menu-trigger" aria-label="Saved stories" title="Saved stories">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 3.5h12a1 1 0 0 1 1 1v16l-7-4-7 4v-16a1 1 0 0 1 1-1Z"></path>
              </svg>
              <span class="saved-count" data-saved-count hidden>0</span>
            </summary>
            <div class="saved-menu-panel">
              <div class="saved-menu-heading">
                <h2>Saved for later</h2>
                <span data-saved-summary>0 stories</span>
              </div>
              <div class="saved-list" data-saved-list>
                <p class="saved-empty">Save a story and it will appear here.</p>
              </div>
            </div>
          </details>

          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-pressed="false"
            aria-label="Switch to dark mode"
          >
            <svg
              class="theme-icon theme-icon-sun"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="3.5"></circle>
              <path
                d="M12 2.5v2M12 19.5v2M4.4 4.4l1.4 1.4M18.2 18.2l1.4 1.4M2.5 12h2M19.5 12h2M4.4 19.6l1.4-1.4M18.2 5.8l1.4-1.4"
              ></path>
            </svg>
            <svg
              class="theme-icon theme-icon-moon"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M20 15.2A8.4 8.4 0 0 1 8.8 4a8.4 8.4 0 1 0 11.2 11.2Z"></path>
            </svg>
          </button>
        </div>
      </nav>

      <slot />

      <Footer />
    </div>

    <script>
      import { initBookmarks } from '../scripts/bookmarks';
      import { initEditionDate } from '../scripts/edition';
      import { initMotion } from '../scripts/motion';
      import { initNavigation } from '../scripts/navigation';
      import { initReadingProgress } from '../scripts/reading-progress';
      import { initSearch } from '../scripts/search';
      import { initSharing } from '../scripts/sharing';
      import { initTheme } from '../scripts/theme';

      initBookmarks();
      initEditionDate();
      initMotion();
      initNavigation();
      initReadingProgress();
      initSearch();
      initSharing();
      initTheme();
    </script>
  </body>
</html>
