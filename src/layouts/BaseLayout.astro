---
import '@fontsource-variable/inter';
import '../styles/global.css';
import TopicPill from '../components/TopicPill.astro';

export interface Props {
  title: string;
  description?: string;
  activeTab?: 'latest' | 'trending' | 'trackers' | null;
  activeTag?: string | null;
  tags: string[];
}

const { title, description, activeTab = null, activeTag = null, tags } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="header-row">
				<a href="/" class="brand">
					<img src="/logo-placeholder.svg" alt="" width="40" height="40" class="brand-mark" />
					<span class="brand-name">AI Snap</span>
				</a>
				<div class="search-box">
					<svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input type="search" id="search-input" placeholder="Search News" aria-label="Search News" />
					<div id="search-results"></div>
				</div>
			</div>
			<div class="pill-row">
				{
					tags.map((tag) => (
						<TopicPill tag={tag} active={activeTag?.toLowerCase() === tag.toLowerCase()} />
					))
				}
			</div>
			<nav class="tab-row">
				<a href="/" class={activeTab === 'latest' ? 'active' : ''}>Latest</a>
				<a href="/trending/" class={activeTab === 'trending' ? 'active' : ''}>Trending</a>
				<a href="/trackers/" class={activeTab === 'trackers' ? 'active' : ''}>Trackers</a>
			</nav>
		</header>
		<div class="page-layout">
			<main>
				<slot />
			</main>
			<aside class="right-rail">
				<slot name="right-rail" />
			</aside>
		</div>
		<script is:inline>
			// Minimal, zero-JS-by-default search: nothing is fetched until the user
			// actually types into the search box. Pagefind's raw JS API is dynamically
			// imported (and initialized) exactly once, on first interaction, instead of
			// loading the much larger pre-built search UI component bundle eagerly on
			// every page.
			//
			// is:inline is required here: a plain <script> is processed by Vite, which
			// rewrites this dynamic import() into its internal preload-helper form and
			// injects an unresolved `__VITE_PRELOAD__` marker, throwing a ReferenceError
			// the moment loadPagefind() runs. is:inline ships this script completely
			// untransformed (no bundling, no rewriting), which avoids that bug entirely.
			const input = document.getElementById('search-input');
			const resultsEl = document.getElementById('search-results');

			let pagefindPromise;
			function loadPagefind() {
				if (!pagefindPromise) {
					pagefindPromise = import('/pagefind/pagefind.js').then(async (mod) => {
						await mod.init();
						return mod;
					});
				}
				return pagefindPromise;
			}

			async function renderResults(query) {
				if (!resultsEl) return;
				if (!query) {
					resultsEl.innerHTML = '';
					return;
				}
				const pagefind = await loadPagefind();
				const search = await pagefind.search(query);
				const entries = await Promise.all(search.results.slice(0, 10).map((result) => result.data()));
				resultsEl.innerHTML = entries
					.map(
						(entry) =>
							`<a class="search-result" href="${entry.url}"><strong>${entry.meta?.title ?? entry.url}</strong><span>${entry.excerpt ?? ''}</span></a>`
					)
					.join('');
			}

			let debounceTimer;
			input?.addEventListener('input', (event) => {
				const query = event.target.value.trim();
				clearTimeout(debounceTimer);
				debounceTimer = setTimeout(() => renderResults(query), 200);
			});
		</script>
	</body>
</html>
