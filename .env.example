# Cloudflare R2 — image storage (see context.md §7)
# Public bucket URL or custom domain, used as the base for `cover` fields in
# src/content/posts/*.md and referenced by astro.config.mjs's
# image.remotePatterns for build-time optimization.
PUBLIC_R2_PUBLIC_URL=

# Only needed once the automation pipeline (Phase 1, §7) uploads generated
# header images directly — not required for local dev against hand-written posts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Newsletter — Substack embed (see context.md §7/§8/§9)
PUBLIC_SUBSTACK_URL=https://aipresshq.substack.com

# Prismic — posts backend (see docs/superpowers/specs/2026-08-04-prismic-backend-migration-design.md)
# Write API token from the Prismic dashboard (Settings > API & Security). Only needed for the
# admin panel (astro dev) and the one-time migration script — the production build's read-only
# loader needs no credentials.
PRISMIC_WRITE_TOKEN=
