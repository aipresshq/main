# Cloudflare R2 — image storage (see docs/superpowers/specs/2026-08-05-cloudflare-deployment-design.md)
# Provisioned. Get real values from the Cloudflare dashboard (R2 → aipresshq-images → Settings,
# and R2 → Overview → Manage API Tokens) if setting up a new local environment.
PUBLIC_R2_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Newsletter — Substack embed (see context.md §7/§8/§9)
PUBLIC_SUBSTACK_URL=https://aipresshq.substack.com

# Prismic — posts backend (see docs/superpowers/specs/2026-08-04-prismic-backend-migration-design.md)
# Write API token from the Prismic dashboard (Settings > API & Security). Only needed for the
# admin panel (astro dev) and the one-time migration script — the production build's read-only
# loader needs no credentials.
PRISMIC_WRITE_TOKEN=

# Production Editorial Desk secrets (set with `wrangler secret put`, never commit values)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Google Indexing API — real-time crawl requests for new/updated posts.
# Full contents of a Google Cloud service account key file, minified to one
# line. That service account must be an Owner on the aipresshq.com property
# in Search Console. Used locally by scripts/google-indexing-ping.mjs; the
# same value also has to be set as a Worker secret (wrangler secret put
# GOOGLE_INDEXING_KEY_JSON) for the admin desk's "Request Google indexing"
# button to work in production — see docs/superpowers/runbooks/admin-production.md.
GOOGLE_INDEXING_KEY_JSON=

# The Worker only needs the public origin for uploaded cover URLs.
# It does not use Moz, Google Search Console, or GA4 credentials.

# Auto-deploy on Prismic publish (Worker secrets, not used locally) —
# see docs/superpowers/runbooks/auto-deploy-on-publish.md
PRISMIC_WEBHOOK_SECRET=
GITHUB_DISPATCH_TOKEN=
