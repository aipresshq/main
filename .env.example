# Cloudflare R2 object storage. Used by integrity and baseline-preservation checks.
PUBLIC_R2_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aipresshq-images

# Newsletter embed.
PUBLIC_SUBSTACK_URL=https://aipresshq.substack.com

# Editorial Desk Worker secrets. Set production values with `wrangler secret put`.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Local command-line publishing. Never set the plain password as a Worker secret.
ADMIN_LOGIN_PASSWORD=
ADMIN_ORIGIN=https://admin.aipresshq.com

# Optional Google Indexing API service-account JSON. See the Cloudflare operations runbook.
GOOGLE_INDEXING_KEY_JSON=

# Never commit real values from this file.
